      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": {
        "content-type": "application/json",
        "prefer": "resolution=ignore-duplicates,return=representation"
      },
      "body": "[{\"id\": 3, \"label\": \"three again\"}, {\"id\": 17, \"label\": \"seventeen\"}]"
    },
    {
