      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json", "prefer": "return=representation" },
      "body": "[{\"id\": 12, \"label\": \"twelve\"}, {\"id\": 13, \"label\": \"thirteen\"}]"
    },
    {
      "name": "a row put in and only some columns handed back",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch?select=label",
      "headers": { "content-type": "application/json", "prefer": "return=representation" },
      "body": "{\"id\": 14, \"label\": \"fourteen\"}"
    },
    {
      "name": "a row put in without something it needs",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json" },
      "body": "{\"id\": 15}"
    },
    {
      "name": "a row put in where one already is",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json" },
      "body": "{\"id\": 1, \"label\": \"again\"}"
    },
    {
      "name": "a body that is not json at all",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json" },
      "body": "{\"id\": 16, \"label\":"
    },
    {
      "name": "a row put in over the one that is there",
      "feature": "upsert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": {
