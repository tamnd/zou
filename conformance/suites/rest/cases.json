      "name": "a row put in with nothing handed back",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json", "prefer": "return=minimal" },
      "body": "{\"id\": 11, \"label\": \"eleven\"}"
