{
  "suite": "rest",
  "note": [
    "The paths are the ones a Supabase project answers on. A bare PostgREST is asked with --strip-prefix /rest/v1.",
    "Every case that reads more than one row orders it, because a diff of two plans is not a diff of two answers.",
    "The writing cases only touch conformance.scratch, which nothing reads, so they cannot move a later answer.",
    "Nothing here sends no key at all: refusing that is the gateway in front of PostgREST rather than PostgREST, so a recording taken from PostgREST would be the wrong answer to keep.",
    "The root of the REST surface is left out for the same reason it is not diffable: the OpenAPI document names the server it came from."
  ],
  "cases": [
    {
      "name": "every row of a table",
      "feature": "select",
      "path": "/rest/v1/tasks?order=id"
    },
    {
      "name": "the columns asked for and no others",
      "feature": "select",
      "path": "/rest/v1/tasks?select=id,title&order=id"
    },
    {
      "name": "a column under another name",
      "feature": "select",
      "path": "/rest/v1/tasks?select=name:title&order=id"
    },
    {
      "name": "a column cast on the way out",
      "feature": "select",
      "path": "/rest/v1/tasks?select=id::text&order=id"
    },
    {
      "name": "a field out of a json column as text",
      "feature": "select",
      "path": "/rest/v1/people?select=name,profile->>city&order=id"
    },
    {
      "name": "a field out of a json column as json",
      "feature": "select",
      "path": "/rest/v1/people?select=name,profile->years&order=id"
    },
    {
      "name": "an array column comes back as an array",
      "feature": "select",
      "path": "/rest/v1/people?select=id,tags&order=id"
    },
    {
      "name": "a numeric column keeps its scale",
      "feature": "select",
      "path": "/rest/v1/projects?select=id,budget&order=id",
      "note": "numeric is text on the wire, and 1200.50 is not 1200.5"
    },
    {
      "name": "equals",
      "feature": "filter",
      "path": "/rest/v1/tasks?done=eq.true&order=id"
    },
    {
      "name": "not equals",
      "feature": "filter",
      "path": "/rest/v1/tasks?project_id=neq.1&order=id"
    },
    {
      "name": "greater than",
      "feature": "filter",
      "path": "/rest/v1/tasks?rank=gt.1&order=id"
    },
    {
      "name": "less than or equal",
      "feature": "filter",
      "path": "/rest/v1/tasks?rank=lte.2&order=id"
    },
    {
      "name": "one of a list",
      "feature": "filter",
      "path": "/rest/v1/tasks?id=in.(1,3,5)&order=id"
    },
    {
      "name": "like with a star for a wildcard",
      "feature": "filter",
      "path": "/rest/v1/tasks?title=like.*the*&order=id"
    },
    {
      "name": "like without regard for case",
      "feature": "filter",
      "path": "/rest/v1/tasks?title=ilike.DRAW*&order=id"
    },
    {
      "name": "is null",
      "feature": "filter",
      "path": "/rest/v1/tasks?rank=is.null&order=id"
    },
    {
      "name": "not, in front of another filter",
      "feature": "filter",
      "path": "/rest/v1/tasks?rank=not.is.null&order=id"
    },
    {
      "name": "either of two filters",
      "feature": "filter",
      "path": "/rest/v1/tasks?or=(id.eq.1,rank.eq.1)&order=id"
    },
    {
      "name": "both of two filters inside either",
      "feature": "filter",
      "path": "/rest/v1/tasks?or=(and(project_id.eq.1,done.is.true),id.eq.5)&order=id"
    },
    {
      "name": "an array that contains",
      "feature": "filter",
      "path": "/rest/v1/people?tags=cs.{roads}&order=id"
    },
    {
      "name": "an array that overlaps",
      "feature": "filter",
      "path": "/rest/v1/people?tags=ov.{maps,nothing}&order=id"
    },
    {
      "name": "a filter on a field inside json",
      "feature": "filter",
      "path": "/rest/v1/people?profile->>city=eq.leeds&order=id"
    },
    {
      "name": "a filter on a date",
      "feature": "filter",
      "path": "/rest/v1/tasks?due=gte.2024-01-01&order=id"
    },
    {
      "name": "a value the column cannot hold",
      "feature": "filter",
      "path": "/rest/v1/tasks?id=eq.notanumber"
    },
    {
      "name": "an operator nobody has",
      "feature": "filter",
      "path": "/rest/v1/tasks?id=nope.1"
    },
    {
      "name": "ordered by a text column",
      "feature": "order",
      "path": "/rest/v1/tasks?select=id,title&order=title"
    },
    {
      "name": "ordered the other way",
      "feature": "order",
      "path": "/rest/v1/tasks?select=id,rank&order=rank.desc,id"
    },
    {
      "name": "ordered with the nulls put last",
      "feature": "order",
      "path": "/rest/v1/tasks?select=id,rank&order=rank.asc.nullslast"
    },
    {
      "name": "ordered by two columns",
      "feature": "order",
      "path": "/rest/v1/tasks?select=id,project_id&order=project_id.desc,id.asc"
    },
    {
      "name": "a limit and an offset",
      "feature": "range",
      "path": "/rest/v1/tasks?select=id&order=id&limit=2&offset=1"
    },
    {
      "name": "a range asked for in a header",
      "feature": "range",
      "path": "/rest/v1/tasks?select=id&order=id",
      "headers": { "range": "0-1" }
    },
    {
      "name": "a range that starts past the end",
      "feature": "range",
      "path": "/rest/v1/tasks?select=id&order=id",
      "headers": { "range": "20-30" }
    },
    {
      "name": "how many rows there are in all",
      "feature": "range",
      "path": "/rest/v1/tasks?select=id&order=id&limit=2",
      "headers": { "prefer": "count=exact" }
    },
    {
      "name": "a count with a filter on it",
      "feature": "range",
      "path": "/rest/v1/tasks?select=id&project_id=eq.1&order=id",
      "headers": { "prefer": "count=exact" }
    },
    {
      "name": "one row asked for as an object",
      "feature": "single",
      "path": "/rest/v1/tasks?id=eq.1",
      "headers": { "accept": "application/vnd.pgrst.object+json" }
    },
    {
      "name": "one row asked for where there are several",
      "feature": "single",
      "path": "/rest/v1/tasks?project_id=eq.1&order=id",
      "headers": { "accept": "application/vnd.pgrst.object+json" }
    },
    {
      "name": "one row asked for where there are none",
      "feature": "single",
      "path": "/rest/v1/tasks?id=eq.999",
      "headers": { "accept": "application/vnd.pgrst.object+json" }
    },
    {
      "name": "the row on the other end of a foreign key",
      "feature": "embed",
      "path": "/rest/v1/tasks?select=id,title,projects(name)&order=id"
    },
    {
      "name": "the rows that point back",
      "feature": "embed",
      "path": "/rest/v1/projects?select=id,name,tasks(id,title)&order=id"
    },
    {
      "name": "an embedded table filtered",
      "feature": "embed",
      "path": "/rest/v1/projects?select=id,tasks(id)&tasks.done=is.true&order=id"
    },
    {
      "name": "an embedded table that has to be there",
      "feature": "embed",
      "path": "/rest/v1/projects?select=id,tasks!inner(id)&tasks.done=is.true&order=id"
    },
    {
      "name": "an embedded table ordered and cut down",
      "feature": "embed",
      "path": "/rest/v1/projects?select=id,tasks(id)&tasks.order=id.desc&tasks.limit=1&order=id"
    },
    {
      "name": "an embed of something that is not related",
      "feature": "embed",
      "path": "/rest/v1/projects?select=id,people(id)"
    },
    {
      "name": "a row put in and handed back",
      "feature": "insert",
      "method": "POST",
      "path": "/rest/v1/scratch",
      "headers": { "content-type": "application/json", "prefer": "return=representation" },
      "body": "{\"id\": 10, \"label\": \"ten\", \"count\": 10}"
    },
