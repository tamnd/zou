+/*
+ * How long a stopping pusher spends getting the store a checkpoint worth
+ * starting from, before it gives up and goes anyway.
+ *
+ * Ten seconds is a checkpoint of a project that has been running plus the
+ * fold of it, with room for a store having a bad minute, and it is time
+ * the node spends once on the way out against time every later start of
+ * that project would spend replaying. ZOU_SHUTDOWN_SETTLE_SECS tunes it
+ * and 0 turns it off, which is the shutdown this worker did before.
+ */
+static int
+zou_settle_secs(void)
+{
+	const char *setting = getenv("ZOU_SHUTDOWN_SETTLE_SECS");
+	int			secs;
+
+	if (setting == NULL)
+		return 10;
+	secs = atoi(setting);
+	return secs > 0 ? secs : 0;
+}
