+/*
+ * Make the store's length cover a page that is about to reach it.
+ *
+ * A page object that outlives the length naming it is the one way a
+ * deferred length loses data. The restore reads the short length, the
+ * pages past it are unreachable, and replay does not put them back,
+ * because the records that made them are below the redo floor the store
+ * was consistent at. A file system gives the rule away for free, a write
+ * past the end is what makes the file longer. Here it is kept by hand:
+ * before a page for block `blk` reaches the store, the length the store
+ * holds has to be past it.
+ *
+ * What goes out is the whole current length, not blk + 1, so a relation
+ * being appended to pays this once and then not again until the pages
+ * being written catch up with the end. Callers with pages they cannot
+ * name a block for pass MaxBlockNumber, which owes the length whenever
+ * the store is behind at all.
+ */
+static void
+zou_relsize_cover(RelFileLocator locator, ForkNumber forknum,
+				  BlockNumber blk)
+{
+	ZouRelSizeKey key = {0};
+	ZouRelSizeEntry *entry;
+	BlockNumber owed = 0;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+	key.locator = locator;
+	key.forknum = forknum;
+
+	LWLockAcquire(&ZouRelSize->lock, LW_SHARED);
+	entry = hash_search(ZouRelSizeHash, &key, HASH_FIND, NULL);
+	if (entry != NULL && entry->nblocks > entry->stored && blk >= entry->stored)
+		owed = entry->nblocks;
+	LWLockRelease(&ZouRelSize->lock);
+	if (owed == 0)
+		return;
+
+	LWLockAcquire(&ZouRelSize->flushlock, LW_SHARED);
+	zou_relsize_put(locator, forknum, owed);
+	LWLockRelease(&ZouRelSize->flushlock);
+}
+
+/*
+ * Make every length an extension left in shared memory durable.
+ *
+ * An extension runs under the relation extension lock, so writing the
+ * new length to the store there put a round trip in front of every
+ * other backend waiting to extend the same relation. It does not have
+ * to be there. What a running cluster reads is the table above, and a
+ * length the store has not heard about is caught up by replay, which
+ * extends a relation to cover any block a record it replays touches.
+ * The one thing replay cannot catch up is a length whose records are
+ * below the redo floor, so the lengths go to the store here, inside the
+ * checkpoint that is about to move that floor. Pages are the other way
+ * a length becomes owed before its checkpoint, and zou_relsize_cover
+ * settles those where they happen.
+ */
+void
+ZouRelSizeFlush(void)
+{
+	HASH_SEQ_STATUS seq;
+	ZouRelSizeEntry *entry;
+	ZouRelSizeEntry *owed;
+	int			nowed = 0;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+
+	LWLockAcquire(&ZouRelSize->flushlock, LW_SHARED);
+	owed = palloc(sizeof(ZouRelSizeEntry) * ZOU_RELSIZE_ENTRIES);
+	LWLockAcquire(&ZouRelSize->lock, LW_SHARED);
+	hash_seq_init(&seq, ZouRelSizeHash);
+	while ((entry = hash_seq_search(&seq)) != NULL)
+	{
+		if (entry->nblocks > entry->stored)
+			owed[nowed++] = *entry;
 	}
 	LWLockRelease(&ZouRelSize->lock);
+
+	/*
+	 * Nothing is marked as gone out until its put returns, so a put that
+	 * fails leaves the length owed and the next checkpoint carries it.
+	 */
+	for (int i = 0; i < nowed; i++)
+		zou_relsize_put(owed[i].key.locator, owed[i].key.forknum,
+						owed[i].nblocks);
+	pfree(owed);
+	LWLockRelease(&ZouRelSize->flushlock);
+	elog(DEBUG1, "zou relsize flushed %d fork lengths", nowed);
 }
 
