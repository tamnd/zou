+zou_relsize_flush_block(void)
+{
+	if (ZouRelSizeHash != NULL)
+		LWLockAcquire(&ZouRelSize->flushlock, LW_EXCLUSIVE);
+}
+
+static void
+zou_relsize_flush_unblock(void)
+{
+	if (ZouRelSizeHash != NULL)
+		LWLockRelease(&ZouRelSize->flushlock);
+}
