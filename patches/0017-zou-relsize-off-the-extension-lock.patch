+/*
+ * Make every length an extension left dirty durable.
+ *
+ * An extension runs under the relation extension lock, so writing the
+ * new length to the store there put a round trip in front of every
+ * other backend waiting to extend the same relation. It does not have
+ * to be there. What a running cluster reads is the table above, and a
+ * length the store has not heard about is caught up by replay, which
+ * extends a relation to cover any block a record it replays touches.
+ * The one thing replay cannot catch up is a length whose records are
+ * below the redo floor, so the lengths go to the store here, inside the
+ * checkpoint that is about to move that floor.
+ *
+ * The flush lock is held shared across the puts and taken exclusively
+ * by truncate and unlink, which is what stops a put of a length from
+ * landing after the SIZE object it names was rewritten or deleted.
+ */
+void
+ZouRelSizeFlush(void)
+{
+	HASH_SEQ_STATUS seq;
+	ZouRelSizeEntry *entry;
+	ZouRelSizeEntry *dirty;
+	int			ndirty = 0;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+
+	LWLockAcquire(&ZouRelSize->flushlock, LW_SHARED);
+	dirty = palloc(sizeof(ZouRelSizeEntry) * ZOU_RELSIZE_ENTRIES);
+	LWLockAcquire(&ZouRelSize->lock, LW_EXCLUSIVE);
+	hash_seq_init(&seq, ZouRelSizeHash);
+	while ((entry = hash_seq_search(&seq)) != NULL)
+	{
+		if (!entry->dirty)
+			continue;
+		dirty[ndirty++] = *entry;
+		entry->dirty = false;
+	}
+	LWLockRelease(&ZouRelSize->lock);
+
+	for (int i = 0; i < ndirty; i++)
+	{
+		RelFileLocator locator = dirty[i].key.locator;
+
+		if (zou_smgr_put_size((uint32) locator.spcOid, (uint32) locator.dbOid,
+							  (uint32) locator.relNumber,
+							  (uint32) dirty[i].key.forknum,
+							  (uint32) dirty[i].nblocks) == 0)
+			continue;
+
+		/* hand back what is still owed, the next checkpoint retries it */
+		for (int j = i; j < ndirty; j++)
+			(void) zou_relsize_note(dirty[j].key.locator, dirty[j].key.forknum,
+									dirty[j].nblocks, ZOU_RELSIZE_EXTEND);
+		LWLockRelease(&ZouRelSize->flushlock);
+		ereport(ERROR,
+				(errcode_for_file_access(),
+				 errmsg("zou smgr could not store the length of rel %u fork %d",
+						locator.relNumber, dirty[i].key.forknum)));
+	}
+	pfree(dirty);
+	LWLockRelease(&ZouRelSize->flushlock);
+	elog(DEBUG1, "zou relsize flushed %d fork lengths", ndirty);
+}
