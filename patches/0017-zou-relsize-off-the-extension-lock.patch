+ * postmaster there is nobody to share with and no checkpoint worth
+ * waiting for, so those keep writing the length on the spot.
+ */
+static bool
+zou_relsize_defer(RelFileLocator locator, ForkNumber forknum,
+				  BlockNumber nblocks)
+{
+	if (!IsUnderPostmaster)
+		return false;
+	return zou_relsize_note(locator, forknum, nblocks, ZOU_RELSIZE_EXTEND);
