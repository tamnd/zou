-	bgw.bgw_start_time = BgWorkerStart_RecoveryFinished;
+
+	/*
+	 * The pusher comes up with the postmaster rather than once recovery
+	 * has finished. A crash leaves local pg_wal ahead of the stream,
+	 * recovery reads its pages from the page service at the lsn it is
+	 * replaying, and the service can only answer once that WAL is in
+	 * the store. Registered any later, the worker that would push it
+	 * waits for the recovery that is waiting for the push, and the node
+	 * never starts again (zou #334).
+	 */
+	bgw.bgw_start_time = BgWorkerStart_PostmasterStart;
 	/* Come back immediately: every second here is commit stall. */
 	bgw.bgw_restart_time = 0;
 	snprintf(bgw.bgw_library_name, sizeof(bgw.bgw_library_name), "postgres");
