+/*
+ * How far local pg_wal is known good.
+ *
+ * Out of recovery that is the flush pointer. In recovery there is no
+ * flush pointer, GetFlushRecPtr asserts on exactly that, and the bytes
+ * that are known good are the ones replay has read and applied, so the
+ * pusher trails replay. That is also the lsn recovery reads its pages
+ * at, so a read parked ahead of the stream costs one push and one
+ * ingest poll rather than the wait cap and a dead startup process.
+ */
+static XLogRecPtr
+zou_wal_local_end(TimeLineID *tli)
+{
+	if (RecoveryInProgress())
+		return GetXLogReplayRecPtr(tli);
+	return GetFlushRecPtr(tli);
+}
+
