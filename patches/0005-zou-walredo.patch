+
+void
+zredo_readv(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+			void **buffers, BlockNumber nblocks)
+{
+	for (BlockNumber i = 0; i < nblocks; i++)
+		load_page(reln->smgr_rlocator.locator, forknum, blocknum + i,
+				  buffers[i]);
+}
+
+/*
+ * Same trick as zoustartreadv in zou_smgr.c: pgaio wants an fd to read
+ * from, so stage the pages into this process's scratch file and point the
+ * IO at the staged region.  The scratch fd is opened before the seccomp
+ * filter goes up; the sandbox only needs pread/pwrite on it.
+ */
+void
+zredo_startreadv(PgAioHandle *ioh, SMgrRelation reln, ForkNumber forknum,
+				 BlockNumber blocknum, void **buffers, BlockNumber nblocks)
+{
+	off_t		region;
+	struct iovec *iov;
+	int			iovcnt PG_USED_FOR_ASSERTS_ONLY;
+	uint8	   *staged;
+
+	Assert(zredo_scratch_fd >= 0);
+
+	region = (off_t) pgaio_io_get_id(ioh) * PG_IOV_MAX * BLCKSZ;
+	staged = palloc((Size) nblocks * BLCKSZ);
+	for (BlockNumber i = 0; i < nblocks; i++)
+		load_page(reln->smgr_rlocator.locator, forknum, blocknum + i,
+				  staged + (Size) i * BLCKSZ);
+	if (pwrite(zredo_scratch_fd, staged, (size_t) nblocks * BLCKSZ, region) !=
+		(ssize_t) ((size_t) nblocks * BLCKSZ))
+		ereport(ERROR,
+				(errcode_for_file_access(),
+				 errmsg("zou redo could not stage pages: %m")));
+	pfree(staged);
+
+	iovcnt = pgaio_io_get_iovec(ioh, &iov);
+	Assert((int) nblocks <= iovcnt);
+	for (BlockNumber i = 0; i < nblocks; i++)
+	{
+		iov[i].iov_base = buffers[i];
+		iov[i].iov_len = BLCKSZ;
+	}
+
+	pgaio_io_set_flag(ioh, PGAIO_HF_BUFFERED);
+	pgaio_io_set_target_smgr(ioh, reln, forknum, blocknum, nblocks, false);
+	pgaio_io_register_callbacks(ioh, PGAIO_HCB_MD_READV, 0);
+	pgaio_io_start_readv(ioh, zredo_scratch_fd, (int) nblocks, region);
+}
