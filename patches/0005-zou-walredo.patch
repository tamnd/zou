+
+void
+zredo_unlink(RelFileLocatorBackend rlocator, ForkNumber forknum, bool isRedo)
+{
+	ZRedoForkKey key;
+
+	forget_pages(rlocator.locator, forknum, forknum == InvalidForkNumber, 0);
+	if (forknum == InvalidForkNumber)
+	{
+		for (int f = 0; f <= MAX_FORKNUM; f++)
+		{
+			memset(&key, 0, sizeof(key));
+			key.locator = rlocator.locator;
+			key.fork = (ForkNumber) f;
+			hash_search(fork_tab, &key, HASH_REMOVE, NULL);
+		}
+	}
+	else
+	{
+		memset(&key, 0, sizeof(key));
+		key.locator = rlocator.locator;
+		key.fork = forknum;
+		hash_search(fork_tab, &key, HASH_REMOVE, NULL);
+	}
+}
