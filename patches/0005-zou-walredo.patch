+/*
+ * Byte order helpers.  The protocol is little endian regardless of host.
+ */
+static inline uint32
+zredo_get_u32(const uint8 *p)
+{
+	return (uint32) p[0] | ((uint32) p[1] << 8) |
+		((uint32) p[2] << 16) | ((uint32) p[3] << 24);
+}
+
+static inline uint64
+zredo_get_u64(const uint8 *p)
+{
+	return (uint64) zredo_get_u32(p) | ((uint64) zredo_get_u32(p + 4) << 32);
+}
+
+static inline void
+zredo_put_u32(uint8 *p, uint32 v)
+{
+	p[0] = (uint8) v;
+	p[1] = (uint8) (v >> 8);
+	p[2] = (uint8) (v >> 16);
+	p[3] = (uint8) (v >> 24);
+}
+
+/*
+ * Parse the 17 byte page address used by 'P' and 'G'.
+ */
+static void
+zredo_get_target(const uint8 *p, RelFileLocator *locator, ForkNumber *fork,
+				 BlockNumber *block)
+{
+	locator->spcOid = zredo_get_u32(p);
+	locator->dbOid = zredo_get_u32(p + 4);
+	locator->relNumber = zredo_get_u32(p + 8);
+	if (p[12] > MAX_FORKNUM)
+		elog(FATAL, "zou redo: bad fork number %d", (int) p[12]);
+	*fork = (ForkNumber) p[12];
+	*block = zredo_get_u32(p + 13);
+}
+
+/*
+ * Exact reads and writes on the request pipe.  A clean EOF at a message
+ * boundary means the pool is done with us.
+ */
+static bool
+read_full(void *dst, size_t len, bool eof_ok)
+{
+	char	   *p = dst;
+	size_t		left = len;
+
+	while (left > 0)
+	{
+		ssize_t		n = read(STDIN_FILENO, p, left);
+
+		if (n == 0)
+		{
+			if (eof_ok && left == len)
+				return false;
+			elog(FATAL, "zou redo: unexpected EOF on request pipe");
+		}
+		if (n < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			elog(FATAL, "zou redo: read from request pipe failed: %m");
+		}
+		p += n;
+		left -= (size_t) n;
+	}
+	return true;
+}
+
+static void
+write_full(const void *src, size_t len)
+{
+	const char *p = src;
+	size_t		left = len;
+
+	while (left > 0)
+	{
+		ssize_t		n = write(STDOUT_FILENO, p, left);
+
+		if (n < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			elog(FATAL, "zou redo: write to response pipe failed: %m");
+		}
+		p += n;
+		left -= (size_t) n;
+	}
+}
+
+/* ----------------------------------------------------------------
+ * In-memory page store
+ *
+ * Base images pushed by the pool and pages spilled from the tiny
+ * shared_buffers pool both land here.  Reads of blocks nobody stored
+ * return zero pages, which is what redo expects for blocks it has not
+ * seen yet.
+ * ----------------------------------------------------------------
+ */
+
+static void
+store_create(void)
+{
+	HASHCTL		ctl;
+
+	ctl.keysize = sizeof(ZRedoPageKey);
+	ctl.entrysize = sizeof(ZRedoPage);
+	ctl.hcxt = store_cxt;
+	page_tab = hash_create("zou redo pages", 64, &ctl,
+						   HASH_ELEM | HASH_BLOBS | HASH_CONTEXT);
+
+	ctl.keysize = sizeof(ZRedoForkKey);
+	ctl.entrysize = sizeof(ZRedoFork);
+	ctl.hcxt = store_cxt;
+	fork_tab = hash_create("zou redo fork sizes", 16, &ctl,
+						   HASH_ELEM | HASH_BLOBS | HASH_CONTEXT);
+
+	ctl.keysize = sizeof(Oid);
+	ctl.entrysize = sizeof(Oid);
+	ctl.hcxt = store_cxt;
+	db_tab = hash_create("zou redo touched dbs", 4, &ctl,
+						 HASH_ELEM | HASH_BLOBS | HASH_CONTEXT);
+}
+
+/*
+ * Between batches every page must go: the same worker serves unrelated
+ * tenants whose relfilelocators can collide.  Buffers are dropped by
+ * database oid, which zredo_open collected for every relation that went
+ * through the buffer manager, so pages that exist only in shared buffers
+ * (FPI restores that were never evicted) are covered too.
+ */
+static void
+store_reset(void)
+{
+	if (db_tab != NULL)
+	{
+		HASH_SEQ_STATUS it;
+		Oid		   *db;
+
+		hash_seq_init(&it, db_tab);
+		while ((db = (Oid *) hash_seq_search(&it)) != NULL)
+			DropDatabaseBuffers(*db);
+	}
+	smgrdestroyall();
+	page_tab = NULL;
+	fork_tab = NULL;
+	db_tab = NULL;
+	MemoryContextReset(store_cxt);
+	store_create();
+}
+
+static ZRedoFork *
+fork_entry(RelFileLocator locator, ForkNumber fork, bool create)
+{
+	ZRedoForkKey key;
+	ZRedoFork  *entry;
+	bool		found;
+
+	memset(&key, 0, sizeof(key));
+	key.locator = locator;
+	key.fork = fork;
+	if (!create)
+		return (ZRedoFork *) hash_search(fork_tab, &key, HASH_FIND, NULL);
+	entry = (ZRedoFork *) hash_search(fork_tab, &key, HASH_ENTER, &found);
+	if (!found)
+		entry->nblocks = 0;
+	return entry;
+}
+
+static void
+store_page(RelFileLocator locator, ForkNumber fork, BlockNumber block,
+		   const void *image)
+{
+	ZRedoPageKey key;
+	ZRedoPage  *page;
+	ZRedoFork  *fk;
+
+	memset(&key, 0, sizeof(key));
+	key.locator = locator;
+	key.fork = fork;
+	key.block = block;
+	page = (ZRedoPage *) hash_search(page_tab, &key, HASH_ENTER, NULL);
+	memcpy(page->image, image, BLCKSZ);
+	fk = fork_entry(locator, fork, true);
+	fk->nblocks = Max(fk->nblocks, block + 1);
+}
+
+static void
+load_page(RelFileLocator locator, ForkNumber fork, BlockNumber block,
+		  void *image)
+{
+	ZRedoPageKey key;
+	ZRedoPage  *page;
+
+	memset(&key, 0, sizeof(key));
+	key.locator = locator;
+	key.fork = fork;
+	key.block = block;
+	page = (ZRedoPage *) hash_search(page_tab, &key, HASH_FIND, NULL);
+	if (page != NULL)
+		memcpy(image, page->image, BLCKSZ);
+	else
+		memset(image, 0, BLCKSZ);
+}
+
+/* drop stored pages of one relation, optionally only from a block up */
+static void
+forget_pages(RelFileLocator locator, ForkNumber fork, bool all_forks,
+			 BlockNumber from_block)
+{
+	HASH_SEQ_STATUS it;
+	ZRedoPage  *page;
+
+	hash_seq_init(&it, page_tab);
+	while ((page = (ZRedoPage *) hash_seq_search(&it)) != NULL)
+	{
+		if (!RelFileLocatorEquals(page->key.locator, locator))
+			continue;
+		if (!all_forks && page->key.fork != fork)
+			continue;
+		if (page->key.block < from_block)
+			continue;
+		hash_search(page_tab, &page->key, HASH_REMOVE, NULL);
+	}
+}
+
+/* ----------------------------------------------------------------
+ * The in-memory smgr, entry 2 in smgr.c's smgrsw table
+ * ----------------------------------------------------------------
+ */
+
+void
+zredo_open(SMgrRelation reln)
+{
+	Oid			db = reln->smgr_rlocator.locator.dbOid;
+
+	/* remember the database so store_reset can drop its buffers */
+	hash_search(db_tab, &db, HASH_ENTER, NULL);
+}
