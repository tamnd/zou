+static void
+zredo_segment_close(XLogReaderState *xlogreader)
+{
+}
+
+/*
+ * Run one record through its redo routine.  The record was never read
+ * from a WAL page, so instead of going through the reader's fetch loop we
+ * decode it in place and install the decoded record directly, the same
+ * shortcut Neon's walredo uses.  DecodeXLogRecord only requires
+ * decoded->oversized to be set when handed an external buffer.
+ *
+ * The end LSN comes from the caller, who read the record out of real WAL
+ * pages and knows how many page headers it crossed.  It cannot be derived
+ * from the length here, and it has to be exact: redo routines stamp it
+ * into the pages they touch as the page LSN.
+ */
+static void
+apply_record(XLogRecPtr lsn, XLogRecPtr end_lsn, XLogRecord *record,
+			 uint32 reclen)
+{
+	DecodedXLogRecord *decoded;
+	char	   *errormsg = NULL;
+
+	if (reclen < SizeOfXLogRecord || record->xl_tot_len != reclen)
+		elog(FATAL, "zou redo: record length %u does not match xl_tot_len %u",
+			 reclen, record->xl_tot_len);
+	if (XLogRecPtrIsInvalid(lsn) || !XRecOffIsValid(lsn))
+		elog(FATAL, "zou redo: bad record LSN %X/%X", LSN_FORMAT_ARGS(lsn));
+	if (end_lsn < lsn + MAXALIGN(record->xl_tot_len))
+		elog(FATAL, "zou redo: bad record end LSN %X/%X for record at %X/%X",
+			 LSN_FORMAT_ARGS(end_lsn), LSN_FORMAT_ARGS(lsn));
+
+	decoded = palloc(DecodeXLogRecordRequiredSpace(record->xl_tot_len));
+	decoded->oversized = true;
+	if (!DecodeXLogRecord(reader, decoded, record, lsn, &errormsg))
+		elog(ERROR, "zou redo: could not decode record at %X/%X: %s",
+			 LSN_FORMAT_ARGS(lsn), errormsg ? errormsg : "unknown error");
+	decoded->next_lsn = end_lsn;
+
+	reader->record = decoded;
+	reader->ReadRecPtr = lsn;
+	reader->EndRecPtr = decoded->next_lsn;
+
+	GetRmgr(XLogRecGetRmid(reader)).rm_redo(reader);
+
+	reader->record = NULL;
+	pfree(decoded);
+}
+
+/* ----------------------------------------------------------------
+ * Request handlers
+ * ----------------------------------------------------------------
+ */
+
+static void
+handle_push(const uint8 *payload, uint32 len)
+{
+	RelFileLocator locator;
+	ForkNumber	fork;
+	BlockNumber block;
+
+	if (len != ZREDO_TARGET_LEN + BLCKSZ)
+		elog(FATAL, "zou redo: bad push length %u", len);
+	zredo_get_target(payload, &locator, &fork, &block);
+	store_page(locator, fork, block, payload + ZREDO_TARGET_LEN);
+}
+
+static void
+handle_apply(uint8 *payload, uint32 len)
+{
+	XLogRecPtr	lsn;
+	XLogRecPtr	end_lsn;
+
+	if (len < 16 + SizeOfXLogRecord)
+		elog(FATAL, "zou redo: bad apply length %u", len);
+	lsn = (XLogRecPtr) zredo_get_u64(payload);
+	end_lsn = (XLogRecPtr) zredo_get_u64(payload + 8);
+
+	/* msgbuf is maxaligned and the record sits 16 bytes in, still aligned */
+	StaticAssertStmt(MAXIMUM_ALIGNOF <= 8, "record alignment");
+	apply_record(lsn, end_lsn, (XLogRecord *) (payload + 16), len - 16);
+}
+
+static void
+handle_get(const uint8 *payload, uint32 len)
+{
+	RelFileLocator locator;
+	ForkNumber	fork;
+	BlockNumber block;
+	Buffer		buf;
+	static uint8 resp[5 + BLCKSZ];
+
+	if (len != ZREDO_TARGET_LEN)
+		elog(FATAL, "zou redo: bad get length %u", len);
+	zredo_get_target(payload, &locator, &fork, &block);
+
+	buf = ReadBufferWithoutRelcache(locator, fork, block, RBM_NORMAL, NULL,
+									true);
+	LockBuffer(buf, BUFFER_LOCK_SHARE);
+	memcpy(resp + 5, BufferGetPage(buf), BLCKSZ);
+	LockBuffer(buf, BUFFER_LOCK_UNLOCK);
+	ReleaseBuffer(buf);
+
+	resp[0] = ZREDO_TAG_PAGE;
+	zredo_put_u32(resp + 1, BLCKSZ);
+	write_full(resp, sizeof(resp));
+}
+
+static void
+request_loop(void)
+{
+	for (;;)
+	{
+		uint8		tag;
+		uint8		lenbuf[4];
+		uint32		len;
+		MemoryContext oldcxt;
+
+		if (!read_full(&tag, 1, true))
+			proc_exit(0);
+		read_full(lenbuf, sizeof(lenbuf), false);
+		len = zredo_get_u32(lenbuf);
+		if (len > ZREDO_MAX_PAYLOAD)
+			elog(FATAL, "zou redo: oversized request of %u bytes", len);
+		if (len > msgbuf_size)
+		{
+			Size		want = Max((Size) len, msgbuf_size * 2);
+
+			msgbuf = repalloc(msgbuf, want);
+			msgbuf_size = want;
+		}
+		if (len > 0)
+			read_full(msgbuf, len, false);
+
+		oldcxt = MemoryContextSwitchTo(scratch_cxt);
+		switch (tag)
+		{
+			case ZREDO_TAG_RESET:
+				if (len != 0)
+					elog(FATAL, "zou redo: bad reset length %u", len);
+				store_reset();
+				break;
+			case ZREDO_TAG_PUSH:
+				handle_push(msgbuf, len);
+				break;
+			case ZREDO_TAG_APPLY:
+				handle_apply(msgbuf, len);
+				break;
+			case ZREDO_TAG_GET:
+				handle_get(msgbuf, len);
+				break;
+			default:
+				elog(FATAL, "zou redo: unknown request tag 0x%02x",
+					 (unsigned) tag);
+		}
+		MemoryContextSwitchTo(oldcxt);
+		MemoryContextReset(scratch_cxt);
+	}
+}
+
+/* ----------------------------------------------------------------
+ * Sandbox
+ * ----------------------------------------------------------------
+ */
+
+#if defined(__linux__) && (defined(__x86_64__) || defined(__aarch64__))
+
+#if defined(__x86_64__)
+#define ZREDO_SECCOMP_ARCH AUDIT_ARCH_X86_64
+#else
+#define ZREDO_SECCOMP_ARCH AUDIT_ARCH_AARCH64
+#endif
+
+#ifndef SECCOMP_RET_KILL_PROCESS
+#define SECCOMP_RET_KILL_PROCESS 0x80000000U
+#endif
+
+/*
+ * Raw BPF allowlist.  Everything the steady state needs: pipe IO, memory,
+ * locking, time, signals and clean exit, plus pread/pwrite for the AIO
+ * scratch file and the sysv teardown calls proc_exit runs into.  Anything
+ * else kills the process and the pool restarts it.
+ */
+static void
+enter_sandbox(void)
+{
+	int			allowed[48];
+	int			n = 0;
+	struct sock_filter prog[4 + lengthof(allowed) * 2];
+	int			pc = 0;
+	struct sock_fprog fprog;
+
+	allowed[n++] = __NR_read;
+	allowed[n++] = __NR_write;
+	allowed[n++] = __NR_close;
+	allowed[n++] = __NR_pread64;
+	allowed[n++] = __NR_pwrite64;
+	allowed[n++] = __NR_preadv;
+	allowed[n++] = __NR_pwritev;
+#ifdef __NR_preadv2
+	allowed[n++] = __NR_preadv2;
+#endif
+#ifdef __NR_pwritev2
+	allowed[n++] = __NR_pwritev2;
+#endif
+#ifdef __NR_fstat
+	allowed[n++] = __NR_fstat;
+#endif
+	allowed[n++] = __NR_lseek;
+	allowed[n++] = __NR_ftruncate;
+	allowed[n++] = __NR_fallocate;
+	allowed[n++] = __NR_exit;
+	allowed[n++] = __NR_exit_group;
+	allowed[n++] = __NR_brk;
+	allowed[n++] = __NR_mmap;
+	allowed[n++] = __NR_munmap;
+	allowed[n++] = __NR_mremap;
+	allowed[n++] = __NR_mprotect;
+	allowed[n++] = __NR_madvise;
+	allowed[n++] = __NR_futex;
+	allowed[n++] = __NR_rt_sigreturn;
+	allowed[n++] = __NR_rt_sigprocmask;
+	allowed[n++] = __NR_rt_sigaction;
+	allowed[n++] = __NR_sigaltstack;
+	allowed[n++] = __NR_getpid;
+	allowed[n++] = __NR_gettid;
+	allowed[n++] = __NR_tgkill;
+	allowed[n++] = __NR_kill;
+	allowed[n++] = __NR_clock_gettime;
+	allowed[n++] = __NR_clock_nanosleep;
+	allowed[n++] = __NR_nanosleep;
+	allowed[n++] = __NR_getrandom;
+	allowed[n++] = __NR_sched_yield;
+	allowed[n++] = __NR_restart_syscall;
+	allowed[n++] = __NR_shmdt;
+	allowed[n++] = __NR_shmctl;
+	allowed[n++] = __NR_semtimedop;
+#ifdef __NR_semop
+	allowed[n++] = __NR_semop;
+#endif
+#ifdef __NR_semget
+	allowed[n++] = __NR_semget;
+#endif
+#ifdef __NR_gettimeofday
+	allowed[n++] = __NR_gettimeofday;
+#endif
+
+	prog[pc++] = (struct sock_filter)
+		BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+				 offsetof(struct seccomp_data, arch));
+	prog[pc++] = (struct sock_filter)
+		BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, ZREDO_SECCOMP_ARCH, 1, 0);
+	prog[pc++] = (struct sock_filter)
+		BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS);
+	prog[pc++] = (struct sock_filter)
+		BPF_STMT(BPF_LD | BPF_W | BPF_ABS,
+				 offsetof(struct seccomp_data, nr));
+	for (int i = 0; i < n; i++)
+	{
+		prog[pc++] = (struct sock_filter)
+			BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, (uint32) allowed[i], 0, 1);
+		prog[pc++] = (struct sock_filter)
+			BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW);
+	}
+	prog[pc++] = (struct sock_filter)
+		BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS);
+
+	fprog.len = (unsigned short) pc;
+	fprog.filter = prog;
+
+	if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0)
+		elog(FATAL, "zou redo: could not set no_new_privs: %m");
+	if (prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &fprog) != 0)
+		elog(FATAL, "zou redo: could not install seccomp filter: %m");
+}
+
+#else							/* no seccomp on this platform */
+
+static void
+enter_sandbox(void)
+{
+	/* development platforms run unsandboxed */
+}
+
+#endif
