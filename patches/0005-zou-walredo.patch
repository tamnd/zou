+/*-------------------------------------------------------------------------
+ *
+ * zou_walredo.h
+ *	  Declarations for the zou WAL redo worker mode.
+ *
+ * The redo worker is a sandboxed postgres process started as
+ * "postgres --zou-redo <scratchdir>".  It speaks a small binary protocol
+ * on stdin/stdout: the pool pushes base page images and WAL records, the
+ * worker applies the records with the real rmgr redo routines against an
+ * in-memory smgr, and returns materialized page images.  See
+ * src/backend/access/transam/zou_walredo.c for the protocol.
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef ZOU_WALREDO_H
+#define ZOU_WALREDO_H
+
+#include "storage/block.h"
+#include "storage/relfilelocator.h"
+#include "storage/smgr.h"
+
+/* true when this process is running as a zou redo worker */
+extern PGDLLIMPORT bool zou_redo_active;
+
+/* entry point, dispatched from main() on --zou-redo */
+pg_noreturn extern void ZouRedoMain(int argc, char *argv[]);
+
+/*
+ * Installs a fabricated in-memory control file so the redo worker never
+ * touches a real pg_control.  Defined in xlog.c because ControlFile is
+ * static there.  Must run before CreateSharedMemoryAndSemaphores so that
+ * XLOGShmemInit copies it into the (private) shared memory copy.
+ */
+extern void ZouRedoInstallFakeControlFile(uint32 data_checksum_version);
+
+/*
+ * The in-memory smgr used while zou_redo_active.  Wired up as a third
+ * entry in smgr.c's smgrsw table.
+ */
+extern void zredo_open(SMgrRelation reln);
+extern void zredo_close(SMgrRelation reln, ForkNumber forknum);
+extern void zredo_create(SMgrRelation reln, ForkNumber forknum, bool isRedo);
+extern bool zredo_exists(SMgrRelation reln, ForkNumber forknum);
+extern void zredo_unlink(RelFileLocatorBackend rlocator, ForkNumber forknum,
+						 bool isRedo);
+extern void zredo_extend(SMgrRelation reln, ForkNumber forknum,
+						 BlockNumber blocknum, const void *buffer,
+						 bool skipFsync);
+extern void zredo_zeroextend(SMgrRelation reln, ForkNumber forknum,
+							 BlockNumber blocknum, int nblocks,
+							 bool skipFsync);
+extern bool zredo_prefetch(SMgrRelation reln, ForkNumber forknum,
+						   BlockNumber blocknum, int nblocks);
+extern uint32 zredo_maxcombine(SMgrRelation reln, ForkNumber forknum,
+							   BlockNumber blocknum);
+extern void zredo_readv(SMgrRelation reln, ForkNumber forknum,
+						BlockNumber blocknum, void **buffers,
+						BlockNumber nblocks);
+extern void zredo_startreadv(PgAioHandle *ioh, SMgrRelation reln,
+							 ForkNumber forknum, BlockNumber blocknum,
+							 void **buffers, BlockNumber nblocks);
+extern void zredo_writev(SMgrRelation reln, ForkNumber forknum,
+						 BlockNumber blocknum, const void **buffers,
+						 BlockNumber nblocks, bool skipFsync);
+extern void zredo_writeback(SMgrRelation reln, ForkNumber forknum,
+							BlockNumber blocknum, BlockNumber nblocks);
+extern BlockNumber zredo_nblocks(SMgrRelation reln, ForkNumber forknum);
+extern void zredo_truncate(SMgrRelation reln, ForkNumber forknum,
+						   BlockNumber old_blocks, BlockNumber nblocks);
+extern void zredo_immedsync(SMgrRelation reln, ForkNumber forknum);
+extern void zredo_registersync(SMgrRelation reln, ForkNumber forknum);
+extern int	zredo_fd(SMgrRelation reln, ForkNumber forknum,
+					 BlockNumber blocknum, uint32 *off);
+
+#endif							/* ZOU_WALREDO_H */
