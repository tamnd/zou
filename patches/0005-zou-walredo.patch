+/*
+ * Install a fabricated control file for the zou WAL redo worker, which has
+ * no real data directory to read one from.  ControlFile is static in this
+ * file, so the worker cannot build it itself.  Only fields consulted at
+ * redo time matter.  data_checksum_version must match the cluster whose WAL
+ * the worker replays: several redo routines behave differently under
+ * XLogHintBitIsNeeded(), for example heap_xlog_visible only advances the
+ * heap page LSN when checksums or wal_log_hints are on, and page reads
+ * verify checksums when the version is nonzero.  The zeroed
+ * minRecoveryPoint also disables minRecoveryPoint updates, so nothing ever
+ * tries to write this fake back to disk.  Must run before
+ * CreateSharedMemoryAndSemaphores so XLOGShmemInit copies it into the
+ * private shared memory copy.
+ */
+void
+ZouRedoInstallFakeControlFile(uint32 data_checksum_version)
+{
+	Assert(ControlFile == NULL);
+	ControlFile = (ControlFileData *) palloc0(sizeof(ControlFileData));
+	ControlFile->pg_control_version = PG_CONTROL_VERSION;
+	ControlFile->catalog_version_no = CATALOG_VERSION_NO;
+	ControlFile->state = DB_IN_ARCHIVE_RECOVERY;
+	ControlFile->wal_level = WAL_LEVEL_REPLICA;
+	ControlFile->maxAlign = MAXIMUM_ALIGNOF;
+	ControlFile->floatFormat = FLOATFORMAT_VALUE;
+	ControlFile->blcksz = BLCKSZ;
+	ControlFile->relseg_size = RELSEG_SIZE;
+	ControlFile->xlog_blcksz = XLOG_BLCKSZ;
+	ControlFile->xlog_seg_size = wal_segment_size;
+	ControlFile->nameDataLen = NAMEDATALEN;
+	ControlFile->indexMaxKeys = INDEX_MAX_KEYS;
+	ControlFile->toast_max_chunk_size = TOAST_MAX_CHUNK_SIZE;
+	ControlFile->loblksize = LOBLKSIZE;
+	ControlFile->float8ByVal = FLOAT8PASSBYVAL;
+	ControlFile->data_checksum_version = data_checksum_version;
+}
