+static MemoryContext store_cxt = NULL;
+static MemoryContext scratch_cxt = NULL;
+static HTAB *page_tab = NULL;
+static HTAB *fork_tab = NULL;
+static HTAB *db_tab = NULL;
+
+static XLogReaderState *reader = NULL;
+
+/* backs pgaio reads of in-memory pages, opened before the sandbox */
+static int	zredo_scratch_fd = -1;
+
+static uint8 *msgbuf = NULL;
+static Size msgbuf_size = 0;
+
+static void store_create(void);
+static void store_reset(void);
+static void handle_push(const uint8 *payload, uint32 len);
+static void handle_apply(uint8 *payload, uint32 len);
+static void handle_get(const uint8 *payload, uint32 len);
+static void apply_record(XLogRecPtr lsn, XLogRecPtr end_lsn,
+						 XLogRecord *record, uint32 reclen);
+pg_noreturn static void request_loop(void);
+static void enter_sandbox(void);
