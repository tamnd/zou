+/* request tags */
+#define ZREDO_TAG_RESET		'R'
+#define ZREDO_TAG_PUSH		'P'
+#define ZREDO_TAG_APPLY		'A'
+#define ZREDO_TAG_GET		'G'
+#define ZREDO_TAG_PAGE		'O'
