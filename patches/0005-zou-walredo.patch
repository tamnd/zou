+/* ----------------------------------------------------------------
+ * Startup
+ * ----------------------------------------------------------------
+ */
+
+void
+ZouRedoMain(int argc, char *argv[])
+{
+	if (argc < 3)
+	{
+		write_stderr("usage: %s --zou-redo <scratchdir> [checksum_version]\n",
+					 argv[0]);
+		proc_exit(1);
+	}
+
+	zou_redo_active = true;
+
+	/* make sure the zou object storage smgr stays inert in this process */
+	unsetenv("ZOU_TARGET");
+
+	InitStandaloneProcess(argv[0]);
+	InitializeGUCOptions();
+
+	/*
+	 * A tiny buffer pool is plenty: it only has to hold the working set of
+	 * one redo batch, and pages evicted from it land in the in-memory
+	 * store.  io_method has to be sync because there are no AIO workers in
+	 * this process.
+	 */
+	SetConfigOption("shared_buffers", "1MB", PGC_POSTMASTER, PGC_S_OVERRIDE);
+	SetConfigOption("io_method", "sync", PGC_POSTMASTER, PGC_S_OVERRIDE);
+	SetConfigOption("max_connections", "4", PGC_POSTMASTER, PGC_S_OVERRIDE);
+	SetConfigOption("max_worker_processes", "2", PGC_POSTMASTER,
+					PGC_S_OVERRIDE);
+	SetConfigOption("max_wal_senders", "0", PGC_POSTMASTER, PGC_S_OVERRIDE);
+
+	/*
+	 * The scratch directory stands in for a data directory: the sysv shmem
+	 * interlock derives its key from it and the AIO scratch file lives in
+	 * it.  No control file, lock file or catalogs are read from it.
+	 */
+	SetDataDir(argv[2]);
+	ChangeToDataDir();
+
+	/*
+	 * A few shared memory init paths scan their on-disk directories even
+	 * though this process never uses them, so give the scratch dir the
+	 * skeleton they expect.
+	 */
+	{
+		static const char *const skeleton[] = {
+			"base", "global", "pg_commit_ts", "pg_multixact",
+			"pg_multixact/members", "pg_multixact/offsets", "pg_notify",
+			"pg_serial", "pg_subtrans", "pg_twophase", "pg_wal", "pg_xact",
+		};
+
+		for (int i = 0; i < (int) lengthof(skeleton); i++)
+		{
+			if (mkdir(skeleton[i], pg_dir_create_mode) != 0 &&
+				errno != EEXIST)
+				ereport(FATAL,
+						(errcode_for_file_access(),
+						 errmsg("zou redo could not create \"%s\": %m",
+								skeleton[i])));
+		}
+	}
+
+	/*
+	 * The worker must mirror the origin cluster's data checksum setting:
+	 * redo routines branch on XLogHintBitIsNeeded, so getting this wrong
+	 * silently produces pages whose LSNs diverge from the primary's.  With
+	 * a nonzero version, pushed base images must carry valid checksums,
+	 * because page reads verify them.
+	 */
+	ZouRedoInstallFakeControlFile(argc > 3 ? (uint32) atoi(argv[3]) : 0);
+
+	InitializeMaxBackends();
+	InitPostmasterChildSlots();
+	InitializeFastPathLocks();
+	InitializeShmemGUCs();
+	InitializeWalConsistencyChecking();
+	CreateSharedMemoryAndSemaphores();
+	set_max_safe_fds();
+	PgStartTime = GetCurrentTimestamp();
+	InitProcess();
+	BaseInit();
+
+	/* buffer pins are tracked per resource owner, aux style suits us */
+	CreateAuxProcessResourceOwner();
+
+	pqsignal(SIGPIPE, SIG_IGN);
+
+	/*
+	 * Redo routines and the machinery under them insist on recovery being
+	 * in progress, which for this process is simply always true.
+	 */
+	InRecovery = true;
+	RmgrStartup();
+
+	reader = XLogReaderAllocate(wal_segment_size, NULL,
+								XL_ROUTINE(.page_read = &zredo_page_read,
+										   .segment_open = &zredo_segment_open,
+										   .segment_close = &zredo_segment_close),
+								NULL);
+	if (reader == NULL)
+		elog(FATAL, "zou redo: out of memory allocating WAL reader");
+
+	{
+		char		path[MAXPGPATH];
+
+		snprintf(path, sizeof(path), "zou-redo-scratch-%d", MyProcPid);
+		zredo_scratch_fd = open(path, O_RDWR | O_CREAT | O_TRUNC, 0600);
+		if (zredo_scratch_fd < 0)
+			ereport(FATAL,
+					(errcode_for_file_access(),
+					 errmsg("zou redo could not open scratch file \"%s\": %m",
+							path)));
+		/* keep the fd, drop the name */
+		unlink(path);
+	}
+
+	store_cxt = AllocSetContextCreate(TopMemoryContext, "zou redo store",
+									  ALLOCSET_DEFAULT_SIZES);
+	scratch_cxt = AllocSetContextCreate(TopMemoryContext, "zou redo scratch",
+										ALLOCSET_DEFAULT_SIZES);
+	msgbuf_size = 64 * 1024;
+	msgbuf = MemoryContextAlloc(TopMemoryContext, msgbuf_size);
+	store_create();
+
+	/* any elog(ERROR) from here on exits the process instead of longjmping */
+	ExitOnAnyError = true;
+
+	if (getenv("ZOU_REDO_NO_SANDBOX") == NULL)
+		enter_sandbox();
+
+	request_loop();
+}
