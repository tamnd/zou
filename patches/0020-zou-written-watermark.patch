+/*
+ * Seed the watermark of a fresh entry from what the store already knows.
+ *
+ * Without this a restart would start every fork at zero and stay there:
+ * the window only reaches 64 blocks past dense, so a writeback anywhere
+ * further along is forgotten, and dense would never move again for a
+ * relation that already has pages. The values come from the same read
+ * the length came from, so this costs nothing extra.
+ */
+static void
+zou_relsize_seed_dense(RelFileLocator locator, ForkNumber forknum,
+					   BlockNumber dense, uint64 filled)
+{
+	ZouRelSizeKey key = {0};
+	ZouRelSizeEntry *entry;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+	key.locator = locator;
+	key.forknum = forknum;
+	LWLockAcquire(&ZouRelSize->lock, LW_EXCLUSIVE);
+	entry = hash_search(ZouRelSizeHash, &key, HASH_FIND, NULL);
+	if (entry != NULL && dense > entry->dense)
+	{
+		entry->dense = Min(dense, entry->nblocks);
+		entry->filled = filled;
+		/* the store already has this much, so it is not owed */
+		entry->flushed = entry->dense;
+		zou_dense_walk(entry);
+	}
+	LWLockRelease(&ZouRelSize->lock);
+}
+
+/*
+ * Record that pages for `nblocks` blocks from `blk` are in the store.
+ *
+ * Called after the write returns, never before: the whole value of the
+ * watermark is that a block below it is a block the store has, and a
+ * claim made ahead of the put would turn a crash in the middle of a
+ * writeback into a fork that accuses itself.
+ *
+ * A block too far past dense to fit the window is dropped. That costs
+ * the detection of that one block until dense walks over it and costs
+ * nothing else, which is the trade this whole structure is: 64 blocks
+ * of memory per fork is what a bulk extension needs and no more.
+ */
+static void
+zou_relsize_filled(RelFileLocator locator, ForkNumber forknum,
+				   BlockNumber blk, BlockNumber nblocks)
+{
+	ZouRelSizeKey key = {0};
+	ZouRelSizeEntry *entry;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+
+	/*
+	 * With the page service on, a checkpointer run's puts are elided:
+	 * the pages go into layers and pg/ keeps whatever it held when the
+	 * session opened. Claiming those blocks here would have the fork
+	 * vouch for objects that were never written, and a later attach
+	 * with the service off would read the claim and refuse a page that
+	 * was never lost. The service owns this question on that path.
+	 */
+	if (zou_pageserve_on() == 1)
+		return;
+
+	key.locator = locator;
+	key.forknum = forknum;
+	LWLockAcquire(&ZouRelSize->lock, LW_EXCLUSIVE);
+	entry = hash_search(ZouRelSizeHash, &key, HASH_FIND, NULL);
+	if (entry != NULL)
+	{
+		for (BlockNumber i = 0; i < nblocks; i++)
+		{
+			BlockNumber b = blk + i;
+			BlockNumber off;
+
+			if (b < entry->dense || b >= entry->nblocks)
+				continue;
+			off = b - entry->dense;
+			if (off >= ZOU_DENSE_WINDOW)
+				continue;
+			entry->filled |= (UINT64CONST(1) << off);
+		}
+		zou_dense_walk(entry);
+	}
+	LWLockRelease(&ZouRelSize->lock);
 }
 
