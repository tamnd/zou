+/*
+ * The written watermark, and why it rides here.
+ *
+ * A block object that is not in the store reads as zeros, which is
+ * right for a block that was extended and never written and is silent
+ * data loss for a block that is gone (zou #546). Telling them apart
+ * needs a record of which blocks have definitely had a page reach the
+ * store, and `dense` is it: every block below it has. `filled` covers
+ * the 64 blocks above `dense` as a bitmap, so a run of blocks extended
+ * together and written back in whatever order the buffer pool evicts
+ * them still carries `dense` along with it.
+ *
+ * It lives in this table because an ordinary page writeback is the one
+ * event that means a block was written and settles no length, so it
+ * has nowhere else to leave the fact. The checkpoint hands both halves
+ * to the store together, in the same object, with the length.
+ *
+ * Both halves only move forward, and `dense` moves only after the page
+ * below it is in the store. Nothing here has to be exact: a watermark
+ * behind the truth costs detection and never accuses a healthy fork,
+ * which is why a fresh entry starts at whatever the store last said
+ * and an update that cannot be represented is dropped rather than
+ * guessed.
+ */
+#define ZOU_DENSE_WINDOW 64
+
 typedef struct ZouRelSizeEntry
 {
 	ZouRelSizeKey key;
 	BlockNumber nblocks;
 	BlockNumber stored;			/* what the store holds, 0 when unknown */
+	BlockNumber dense;			/* every block below this has a page */
+	uint64		filled;			/* pages written in [dense, dense + 64) */
+	BlockNumber flushed;		/* the dense the store was last told */
 } ZouRelSizeEntry;
 
+/*
+ * Walk dense over the prefix of the window that is set. Caller holds
+ * the table lock exclusively.
+ */
+static void
+zou_dense_walk(ZouRelSizeEntry *entry)
+{
+	int			steps = 0;
+
+	while (steps < ZOU_DENSE_WINDOW && (entry->filled & (UINT64CONST(1) << steps)) != 0)
+		steps++;
+	if (steps == 0)
+		return;
+	entry->dense += (BlockNumber) steps;
+	entry->filled = (steps >= ZOU_DENSE_WINDOW) ? 0 : (entry->filled >> steps);
+	if (entry->dense > entry->nblocks)
+	{
+		entry->dense = entry->nblocks;
+		entry->filled = 0;
+	}
+}
