 			{
 				/*
-				 * The lag bounds refused admission, consolidation is
-				 * too far behind. Nap and retry the same chunk: staged
-				 * WAL stops growing, the commit gate stalls honestly,
-				 * and the fold thread's next backlog report lifts the
-				 * throttle. Log once per streak, not per retry.
+				 * A lag bound refused admission: this tenant's ingest
+				 * is too far behind, or consolidation on the shard is.
+				 * Nap and retry the same chunk: staged WAL stops
+				 * growing, the commit gate stalls honestly, and the
+				 * next gauge report lifts the throttle. Log once per
+				 * streak, not per retry, and say which bound tripped,
+				 * since that is the whole use of the line: the three
+				 * reasons are three different things to go look at.
 				 */
 				if (!throttled)
-					ereport(LOG,
-							(errmsg("zou wal pusher throttled, consolidation is behind")));
+				{
+					char		reason[256];
+
+					if (zou_wal_throttle_reason(reason, sizeof(reason)) > 0)
+						ereport(LOG,
+								(errmsg("zou wal pusher throttled: %s", reason)));
+					else
+						ereport(LOG,
+								(errmsg("zou wal pusher throttled, a lag bound is blown")));
