+/*
+ * The last written LSN of a block, and why a read needs one.
+ *
+ * With the page service on, a read is served by ingest rather than by
+ * the store, and ingest has to have applied far enough forward for the
+ * answer to be the page the backend asked for. What the backend has
+ * been naming so far is the WAL pusher's durable LSN, which is one
+ * position for the whole cluster: the newest thing anybody in the
+ * tenant wrote. So a read of a page nobody has touched in an hour
+ * waits for whatever the busiest writer did a microsecond ago. The
+ * measurement on zou #671 is that all of it is that: 17277 parks in a
+ * five minute run, and not one of them was waiting for WAL that
+ * touched the page it had been asked for.
+ *
+ * A block's own last written LSN is the position that actually
+ * matters. Everything after it, however much there is, changed some
+ * other block, so a page reconstructed anywhere at or after it is the
+ * page this read wants. This table is where that position is kept.
+ *
+ * It is a direct mapped array of positions with no keys in it. A slot
+ * holds the newest LSN of every block that has ever hashed to it, and
+ * a read of any of those blocks waits for that. Sharing a slot with a
+ * busier block costs a wait for somebody else's writes, which is what
+ * the whole cluster was doing before this existed, and it costs it to
+ * one block in nslots rather than to all of them.
+ *
+ * The keyless shape is the second attempt and the first one is worth
+ * recording. It kept a key per slot and folded the position of an
+ * evicted block into a floor that every block without a slot read at.
+ * The floor is a maximum, evictions under a write heavy run carry the
+ * positions of blocks written a moment ago, so it climbed to within a
+ * hair of the newest LSN and every read waited there. Measured on
+ * gamingpc it was indistinguishable from not having the table: 373 tps
+ * on the write mix and 12604 on the read one, both inside the range of
+ * the runs before it.
+ *
+ * A slot at zero means no block that hashes there has been written
+ * back since this postmaster started, so the read falls back to the
+ * floor, which is seeded once with the WAL flush position at the first
+ * read. A write back flushes the block's WAL first, so that position
+ * is at or past the last change to every block written back before it,
+ * and nothing else can be in the store to read.
+ *
+ * Both of those rest on the same thing: a block still dirty in a
+ * buffer is read out of the buffer and never reaches this code at all,
+ * so the only blocks a read can ask for are blocks that have been
+ * written back.
+ *
+ * Recovery does not use any of this. The startup process reads a page
+ * to replay a record onto, and it needs that page at exactly the
+ * position it has replayed to rather than at the newest one available,
+ * so it keeps naming the LSN it is replaying (zou #329).
+ */
+typedef struct ZouLwLsnKey
+{
+	RelFileLocator locator;
+	ForkNumber	forknum;
+	BlockNumber blocknum;
+} ZouLwLsnKey;
+
+/*
+ * 128k slots, a megabyte of shared memory, and it holds the last
+ * written position of a gigabyte of pages with no collisions to speak
+ * of. ZOU_LWLSN_ENTRIES tunes it and 0 turns the table off, which
+ * leaves every read naming the durable LSN the way it did before this
+ * existed, and is how the two are compared on one binary.
+ */
+#define ZOU_LWLSN_DEFAULT 131072
+
+typedef struct ZouLwLsnCtl
+{
+	int			nslots;
+	pg_atomic_uint64 floor;
+} ZouLwLsnCtl;
+
+static ZouLwLsnCtl *ZouLwLsn = NULL;
+static pg_atomic_uint64 *ZouLwLsnSlots = NULL;
+
+static int
+zou_lwlsn_slots(void)
+{
+	const char *setting = getenv("ZOU_LWLSN_ENTRIES");
+	int			n;
+
+	if (setting == NULL)
+		return ZOU_LWLSN_DEFAULT;
+	n = atoi(setting);
+	return n > 0 ? n : 0;
+}
+
+static inline uint32
+zou_lwlsn_slot(RelFileLocator locator, ForkNumber forknum,
+			   BlockNumber blocknum)
+{
+	ZouLwLsnKey key = {0};
+
+	key.locator = locator;
+	key.forknum = forknum;
+	key.blocknum = blocknum;
+	return hash_bytes((const unsigned char *) &key, sizeof(key)) %
+		(uint32) ZouLwLsn->nslots;
+}
+
+/*
+ * Move a position forward, from however many backends at once. Forward
+ * only: two backends writing the same block back is one of them
+ * holding an older copy of the page, and the older LSN would let a
+ * read be served before the newer change had arrived.
+ */
+static void
+zou_lwlsn_raise(pg_atomic_uint64 *at, XLogRecPtr lsn)
+{
+	uint64		was = pg_atomic_read_u64(at);
+
+	while (was < (uint64) lsn)
+	{
+		if (pg_atomic_compare_exchange_u64(at, &was, (uint64) lsn))
+			return;
+	}
+}
+
+Size
+ZouLwLsnShmemSize(void)
+{
+	int			n = zou_lwlsn_slots();
+
+	if (n == 0)
+		return 0;
+	return add_size(MAXALIGN(sizeof(ZouLwLsnCtl)),
+					mul_size(sizeof(pg_atomic_uint64), (Size) n));
+}
+
+void
+ZouLwLsnShmemInit(void)
+{
+	int			n = zou_lwlsn_slots();
+	bool		found;
+
+	if (n == 0)
+		return;
+	ZouLwLsn = (ZouLwLsnCtl *)
+		ShmemInitStruct("zou lwlsn", sizeof(ZouLwLsnCtl), &found);
+	if (!found)
+	{
+		ZouLwLsn->nslots = n;
+		pg_atomic_init_u64(&ZouLwLsn->floor, 0);
+	}
+
+	ZouLwLsnSlots = (pg_atomic_uint64 *)
+		ShmemInitStruct("zou lwlsn slots",
+						mul_size(sizeof(pg_atomic_uint64), (Size) n), &found);
+	if (!found)
+		for (int i = 0; i < n; i++)
+			pg_atomic_init_u64(&ZouLwLsnSlots[i], 0);
+}
+
+/*
+ * Say that this block was last changed at `lsn`.
+ *
+ * Called with the page in hand on the way out of the buffer pool, so
+ * the LSN is the page's own. A page with no LSN was never WAL logged,
+ * and one of those is written to the store eagerly rather than served
+ * out of the stream, so there is nothing here for it to wait for and
+ * nothing worth a slot.
+ */
+void
+ZouLwLsnNote(RelFileLocator locator, ForkNumber forknum,
+			 BlockNumber blocknum, XLogRecPtr lsn)
+{
+	if (ZouLwLsnSlots == NULL || XLogRecPtrIsInvalid(lsn))
+		return;
+	zou_lwlsn_raise(&ZouLwLsnSlots[zou_lwlsn_slot(locator, forknum, blocknum)],
+					lsn);
+}
+
+/*
+ * The newest position any of `nblocks` blocks from `blocknum` was
+ * written at, or InvalidXLogRecPtr when the table has nothing to say
+ * and the caller should keep naming the durable LSN.
+ *
+ * The newest rather than each, because the whole run is served
+ * together, so the run waits for whichever of its blocks waits
+ * longest.
+ */
+XLogRecPtr
+ZouLwLsnRange(RelFileLocator locator, ForkNumber forknum,
+			  BlockNumber blocknum, BlockNumber nblocks)
+{
+	XLogRecPtr	floor;
+	XLogRecPtr	newest = InvalidXLogRecPtr;
+
+	if (ZouLwLsnSlots == NULL || RecoveryInProgress())
+		return InvalidXLogRecPtr;
+	floor = (XLogRecPtr) pg_atomic_read_u64(&ZouLwLsn->floor);
+	if (XLogRecPtrIsInvalid(floor))
+	{
+		/*
+		 * The first read of the cluster seeds it. GetFlushRecPtr is at
+		 * or past the last change to every block that has been written
+		 * back, which is every block a slot at zero can stand for.
+		 */
+		zou_lwlsn_raise(&ZouLwLsn->floor, GetFlushRecPtr(NULL));
+		floor = (XLogRecPtr) pg_atomic_read_u64(&ZouLwLsn->floor);
+		if (XLogRecPtrIsInvalid(floor))
+			return InvalidXLogRecPtr;
+	}
+	for (BlockNumber i = 0; i < nblocks; i++)
+	{
+		XLogRecPtr	mine;
+
+		mine = (XLogRecPtr) pg_atomic_read_u64(
+			&ZouLwLsnSlots[zou_lwlsn_slot(locator, forknum, blocknum + i)]);
+		if (XLogRecPtrIsInvalid(mine))
+			mine = floor;
+		if (mine > newest)
+			newest = mine;
+	}
+	return newest;
+}
