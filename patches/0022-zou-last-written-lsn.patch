+
+/*
+ * The last written LSN of a block, and why a read needs one.
+ *
+ * With the page service on, a read is served by ingest rather than by
+ * the store, and ingest has to have applied far enough forward for the
+ * answer to be the page the backend asked for. What the backend has
+ * been naming so far is the WAL pusher's durable LSN, which is one
+ * position for the whole cluster: the newest thing anybody in the
+ * tenant wrote. So a read of a page nobody has touched in an hour
+ * waits for whatever the busiest writer did a microsecond ago. The
+ * measurement on zou #671 is that all of it is that: 17277 parks in a
+ * five minute run, and not one of them was waiting for WAL that
+ * touched the page it had been asked for.
+ *
+ * A block's own last written LSN is the position that actually
+ * matters. Everything after it, however much there is, changed some
+ * other block, so a page reconstructed anywhere at or after it is the
+ * page this read wants. This table is where that position is kept.
+ *
+ * It is a direct mapped cache rather than a hash with an LRU, because
+ * what a miss costs is a wait rather than a wrong answer and the
+ * simpler structure is easier to be sure of. A slot holds one block,
+ * an insert over a different block evicts it, and an eviction raises
+ * the floor to the LSN it dropped. A block with no slot of its own
+ * reads that floor, which says no block this table has forgotten was
+ * written after it, and is a true bound for the same reason the table
+ * is: a block is only written back by the buffer manager after the WAL
+ * that changed it is flushed, and a block still dirty in a buffer is
+ * read from the buffer rather than from here.
+ *
+ * The floor starts unset, and unset means say nothing: the read falls
+ * back to the durable LSN it named before, which is the behaviour this
+ * cache is replacing. It is seeded once, on the first read that finds
+ * it unset, with the WAL flush position at that moment. Every block
+ * not in the table by then has been written back, and a write back
+ * flushes its WAL first, so the flush position is at or past the last
+ * change to any of them.
+ *
+ * Recovery does not use any of this. The startup process reads a page
+ * to replay a record onto, and it needs that page at exactly the
+ * position it has replayed to rather than at the newest one available,
+ * so it keeps naming the LSN it is replaying (zou #329).
+ */
+typedef struct ZouLwLsnKey
+{
+	RelFileLocator locator;
+	ForkNumber	forknum;
+	BlockNumber blocknum;
+} ZouLwLsnKey;
+
+typedef struct ZouLwLsnEntry
+{
+	ZouLwLsnKey key;
+	XLogRecPtr	lsn;
+} ZouLwLsnEntry;
+
+/*
+ * One lock per stripe of slots. A writeback of eight blocks and a read
+ * of eight more are the two things that touch this table, both of them
+ * on paths that already move 8 kB a block, so the lock is not what
+ * this costs. Striping is here so that a busy pool is not serialized
+ * through one LWLock on every buffer it evicts.
+ */
+#define ZOU_LWLSN_PARTITIONS 16
+
+/*
+ * 128k blocks, 4 MB of shared memory, and it holds the last written
+ * position of a gigabyte of pages. ZOU_LWLSN_ENTRIES tunes it and 0
+ * turns the table off, which leaves every read naming the durable LSN
+ * the way it did before this existed.
+ */
+#define ZOU_LWLSN_DEFAULT 131072
+
+typedef struct ZouLwLsnCtl
+{
+	int			tranche;
+	int			nslots;
+	pg_atomic_uint64 floor;
+	LWLock		locks[ZOU_LWLSN_PARTITIONS];
+} ZouLwLsnCtl;
+
+static ZouLwLsnCtl *ZouLwLsn = NULL;
+static ZouLwLsnEntry *ZouLwLsnSlots = NULL;
+
+static int
+zou_lwlsn_slots(void)
+{
+	const char *setting = getenv("ZOU_LWLSN_ENTRIES");
+	int			n;
+
+	if (setting == NULL)
+		return ZOU_LWLSN_DEFAULT;
+	n = atoi(setting);
+	return n > 0 ? n : 0;
+}
+
+static inline uint32
+zou_lwlsn_slot(const ZouLwLsnKey *key)
+{
+	return hash_bytes((const unsigned char *) key, sizeof(ZouLwLsnKey)) %
+		(uint32) ZouLwLsn->nslots;
+}
+
+static inline LWLock *
+zou_lwlsn_lock(uint32 slot)
+{
+	return &ZouLwLsn->locks[slot % ZOU_LWLSN_PARTITIONS];
+}
+
+/* Raise the floor to `lsn`, from however many backends at once. */
+static void
+zou_lwlsn_raise(XLogRecPtr lsn)
+{
+	uint64		was = pg_atomic_read_u64(&ZouLwLsn->floor);
+
+	while (was < (uint64) lsn)
+	{
+		if (pg_atomic_compare_exchange_u64(&ZouLwLsn->floor, &was,
+										   (uint64) lsn))
+			return;
+	}
+}
+
+Size
+ZouLwLsnShmemSize(void)
+{
+	int			n = zou_lwlsn_slots();
+
+	if (n == 0)
+		return 0;
+	return add_size(MAXALIGN(sizeof(ZouLwLsnCtl)),
+					mul_size(sizeof(ZouLwLsnEntry), (Size) n));
+}
+
+void
+ZouLwLsnShmemInit(void)
+{
+	int			n = zou_lwlsn_slots();
+	bool		found;
+
+	if (n == 0)
+		return;
+	ZouLwLsn = (ZouLwLsnCtl *)
+		ShmemInitStruct("zou lwlsn", sizeof(ZouLwLsnCtl), &found);
+	if (!found)
+	{
+		ZouLwLsn->tranche = LWLockNewTrancheId();
+		ZouLwLsn->nslots = n;
+		pg_atomic_init_u64(&ZouLwLsn->floor, 0);
+		for (int i = 0; i < ZOU_LWLSN_PARTITIONS; i++)
+			LWLockInitialize(&ZouLwLsn->locks[i], ZouLwLsn->tranche);
+	}
+	LWLockRegisterTranche(ZouLwLsn->tranche, "zou_lwlsn");
+
+	ZouLwLsnSlots = (ZouLwLsnEntry *)
+		ShmemInitStruct("zou lwlsn slots",
+						mul_size(sizeof(ZouLwLsnEntry), (Size) n), &found);
+	if (!found)
+		memset(ZouLwLsnSlots, 0, sizeof(ZouLwLsnEntry) * (Size) n);
+}
+
+/*
+ * Say that this block was last changed at `lsn`.
+ *
+ * Called with the page in hand on the way out of the buffer pool, so
+ * the LSN is the page's own. A page with no LSN was never WAL logged,
+ * and one of those is written to the store eagerly rather than served
+ * out of the stream, so there is nothing here for it to wait for and
+ * nothing worth a slot.
+ */
+void
+ZouLwLsnNote(RelFileLocator locator, ForkNumber forknum,
+			 BlockNumber blocknum, XLogRecPtr lsn)
+{
+	ZouLwLsnKey key = {0};
+	ZouLwLsnEntry *slot;
+	uint32		at;
+	LWLock	   *lock;
+
+	if (ZouLwLsnSlots == NULL || XLogRecPtrIsInvalid(lsn))
+		return;
+	key.locator = locator;
+	key.forknum = forknum;
+	key.blocknum = blocknum;
+	at = zou_lwlsn_slot(&key);
+	lock = zou_lwlsn_lock(at);
+	slot = &ZouLwLsnSlots[at];
+
+	LWLockAcquire(lock, LW_EXCLUSIVE);
+	if (memcmp(&slot->key, &key, sizeof(ZouLwLsnKey)) == 0)
+	{
+		/*
+		 * Forward only. Two backends writing the same block back is one
+		 * of them holding an older copy of the page, and the older LSN
+		 * would let a read be served before the newer change arrived.
+		 */
+		if (slot->lsn < lsn)
+			slot->lsn = lsn;
+		LWLockRelease(lock);
+		return;
+	}
+	if (!XLogRecPtrIsInvalid(slot->lsn))
+		zou_lwlsn_raise(slot->lsn);
+	slot->key = key;
+	slot->lsn = lsn;
+	LWLockRelease(lock);
+}
+
+/*
+ * The newest position any of `nblocks` blocks from `blocknum` was
+ * written at, or InvalidXLogRecPtr when the table has nothing to say
+ * and the caller should keep naming the durable LSN.
+ *
+ * The newest rather than each, because the whole run is served
+ * together, so the run waits for whichever of its blocks waits
+ * longest.
+ */
+XLogRecPtr
+ZouLwLsnRange(RelFileLocator locator, ForkNumber forknum,
+			  BlockNumber blocknum, BlockNumber nblocks)
+{
+	ZouLwLsnKey key = {0};
+	XLogRecPtr	floor;
+	XLogRecPtr	newest = InvalidXLogRecPtr;
+
+	if (ZouLwLsnSlots == NULL || RecoveryInProgress())
+		return InvalidXLogRecPtr;
+	floor = (XLogRecPtr) pg_atomic_read_u64(&ZouLwLsn->floor);
+	if (XLogRecPtrIsInvalid(floor))
+	{
+		/*
+		 * The first read of the cluster seeds it. GetFlushRecPtr is at
+		 * or past the last change to every block that has been written
+		 * back, which is every block this table does not hold.
+		 */
+		zou_lwlsn_raise(GetFlushRecPtr(NULL));
+		floor = (XLogRecPtr) pg_atomic_read_u64(&ZouLwLsn->floor);
+		if (XLogRecPtrIsInvalid(floor))
+			return InvalidXLogRecPtr;
+	}
+	key.locator = locator;
+	key.forknum = forknum;
+	for (BlockNumber i = 0; i < nblocks; i++)
+	{
+		ZouLwLsnEntry *slot;
+		XLogRecPtr	mine;
+		uint32		at;
+		LWLock	   *lock;
+
+		key.blocknum = blocknum + i;
+		at = zou_lwlsn_slot(&key);
+		lock = zou_lwlsn_lock(at);
+		slot = &ZouLwLsnSlots[at];
+		LWLockAcquire(lock, LW_SHARED);
+		mine = memcmp(&slot->key, &key, sizeof(ZouLwLsnKey)) == 0
+			? slot->lsn : floor;
+		LWLockRelease(lock);
+		if (mine > newest)
+			newest = mine;
+	}
+	return newest;
 }
 
