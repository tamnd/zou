+/*
+ * Relation sizes answered from shared memory.
+ *
+ * Stock Postgres answers smgrnblocks with an lseek, cheap enough that
+ * the planner asks for every table and index it plans over, on every
+ * query. Under zou the honest answer lives in the store, and a store
+ * round trip per planned relation multiplies each statement by the
+ * store latency. This node is the only writer of its relations, the
+ * chain fence guarantees it, and every size change flows through this
+ * smgr, so a shared table kept current by extend, truncate and unlink
+ * is as authoritative as the store. A miss pays the store read once
+ * per relation fork; a full table just means paying it again.
+ */
+typedef struct ZouRelSizeKey
+{
+	RelFileLocator locator;
+	ForkNumber	forknum;
+} ZouRelSizeKey;
+
+typedef struct ZouRelSizeEntry
+{
+	ZouRelSizeKey key;
+	BlockNumber nblocks;
+} ZouRelSizeEntry;
+
+typedef struct ZouRelSizeCtl
+{
+	int			tranche;
+	LWLock		lock;
+} ZouRelSizeCtl;
+
+#define ZOU_RELSIZE_ENTRIES 4096
+
+static ZouRelSizeCtl *ZouRelSize = NULL;
+static HTAB *ZouRelSizeHash = NULL;
+
+typedef enum ZouRelSizeMode
+{
+	ZOU_RELSIZE_SEED,			/* keep an existing entry, fill a miss */
+	ZOU_RELSIZE_GROW,			/* raise to nblocks, never lower */
+	ZOU_RELSIZE_SET,			/* overwrite */
+} ZouRelSizeMode;
+
+Size
+ZouRelSizeShmemSize(void)
+{
+	return add_size(MAXALIGN(sizeof(ZouRelSizeCtl)),
+					hash_estimate_size(ZOU_RELSIZE_ENTRIES,
+									   sizeof(ZouRelSizeEntry)));
+}
+
+void
+ZouRelSizeShmemInit(void)
+{
+	HASHCTL		info;
+	bool		found;
+
+	ZouRelSize = (ZouRelSizeCtl *)
+		ShmemInitStruct("zou relsize", sizeof(ZouRelSizeCtl), &found);
+	if (!found)
+	{
+		ZouRelSize->tranche = LWLockNewTrancheId();
+		LWLockInitialize(&ZouRelSize->lock, ZouRelSize->tranche);
+	}
+	LWLockRegisterTranche(ZouRelSize->tranche, "zou_relsize");
+
+	info.keysize = sizeof(ZouRelSizeKey);
+	info.entrysize = sizeof(ZouRelSizeEntry);
+	ZouRelSizeHash = ShmemInitHash("zou relsize hash",
+								   ZOU_RELSIZE_ENTRIES,
+								   ZOU_RELSIZE_ENTRIES,
+								   &info, HASH_ELEM | HASH_BLOBS);
+}
+
+static bool
+zou_relsize_lookup(SMgrRelation reln, ForkNumber forknum, BlockNumber *nblocks)
+{
+	ZouRelSizeKey key = {0};
+	ZouRelSizeEntry *entry;
+
+	if (ZouRelSizeHash == NULL)
+		return false;
+	key.locator = reln->smgr_rlocator.locator;
+	key.forknum = forknum;
+	LWLockAcquire(&ZouRelSize->lock, LW_SHARED);
+	entry = hash_search(ZouRelSizeHash, &key, HASH_FIND, NULL);
+	if (entry != NULL)
+		*nblocks = entry->nblocks;
+	LWLockRelease(&ZouRelSize->lock);
+	return entry != NULL;
+}
+
+static void
+zou_relsize_note(RelFileLocator locator, ForkNumber forknum,
+				 BlockNumber nblocks, ZouRelSizeMode mode)
+{
+	ZouRelSizeKey key = {0};
+	ZouRelSizeEntry *entry;
+	bool		found;
+
+	if (ZouRelSizeHash == NULL)
+		return;
+	key.locator = locator;
+	key.forknum = forknum;
+	LWLockAcquire(&ZouRelSize->lock, LW_EXCLUSIVE);
+	/* HASH_ENTER_NULL: a full table degrades to uncached, never errors */
+	entry = hash_search(ZouRelSizeHash, &key, HASH_ENTER_NULL, &found);
+	if (entry != NULL)
+	{
+		if (!found ||
+			mode == ZOU_RELSIZE_SET ||
+			(mode == ZOU_RELSIZE_GROW && nblocks > entry->nblocks))
+			entry->nblocks = nblocks;
+	}
+	LWLockRelease(&ZouRelSize->lock);
+}
+
+static void
+zou_relsize_forget(RelFileLocator locator, ForkNumber forknum)
+{
+	ZouRelSizeKey key = {0};
+
+	if (ZouRelSizeHash == NULL)
+		return;
+	key.locator = locator;
+	key.forknum = forknum;
+	LWLockAcquire(&ZouRelSize->lock, LW_EXCLUSIVE);
+	(void) hash_search(ZouRelSizeHash, &key, HASH_REMOVE, NULL);
+	LWLockRelease(&ZouRelSize->lock);
+}
