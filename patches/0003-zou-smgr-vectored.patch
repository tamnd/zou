+/*
+ * A skipFsync page may buffer in process on the Rust side because its
+ * durability comes due at smgrregistersync or smgrimmedsync. Bootstrap
+ * and single user backends break that contract, initdb settles
+ * durability by fsyncing the data directory itself and relation pages
+ * never live there under zou, so outside a postmaster every write goes
+ * to the store eagerly.
+ */
+static inline int
+zou_skip_fsync(bool skipFsync)
+{
+	return (skipFsync && IsUnderPostmaster) ? 1 : 0;
+}
