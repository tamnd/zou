+	zou_check(zou_smgr_sync(ZOU_LOCATOR(reln), (uint32) forknum),
+			  "sync", reln, forknum);
 }
 
 void
 zouregistersync(SMgrRelation reln, ForkNumber forknum)
 {
+	/*
+	 * md defers this to the next checkpoint. The store has no fsync to
+	 * defer to, so durability settles here, which still amortizes the
+	 * whole bulk fill into one parallel drain.
+	 */
+	zou_check(zou_smgr_sync(ZOU_LOCATOR(reln), (uint32) forknum),
+			  "sync", reln, forknum);
 }
 
