@@ -0,0 +1,370 @@
+/*-------------------------------------------------------------------------
+ *
+ * zou_wal.c
+ *	  mirrors flushed WAL into zou-store and gates COMMIT on the
+ *	  durable object storage flush.
+ *
+ *	  zou-store has a single writer lease per tenant, but XLogWrite runs
+ *	  in whichever process holds WALWriteLock, so the push cannot happen
+ *	  at the flush site. Instead one background worker, the zou wal
+ *	  pusher, owns the lease and tails pg_wal: it reads every byte the
+ *	  cluster has flushed locally, appends it to the zou group commit
+ *	  pipeline, and publishes the durable LSN into shared memory.
+ *	  Committing backends wait on that LSN after their local flush, the
+ *	  same shape as a synchronous replication ack.
+ *
+ *	  Part of the zou patch series, not upstream PostgreSQL.
+ *
+ * src/backend/access/transam/zou_wal.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "access/xlog.h"
+#include "access/xlog_internal.h"
+#include "access/zou_wal.h"
+#include "miscadmin.h"
+#include "pgstat.h"
+#include "port/atomics.h"
+#include "postmaster/bgworker.h"
+#include "postmaster/interrupt.h"
+#include "storage/condition_variable.h"
+#include "storage/fd.h"
+#include "storage/ipc.h"
+#include "storage/latch.h"
+#include "storage/shmem.h"
+#include "utils/wait_event.h"
+
+/* C ABI of the zou-pg crate (crates/zou-pg). */
+extern int	zou_wal_open(const char *target, uint64 flush_lsn,
+						 uint64 *out_resume);
+extern int	zou_wal_append(const uint8 *data, size_t len, uint64 pg_lsn,
+						   uint64 *out_durable);
+extern int	zou_wal_fold(uint64 redo, uint32 *out_dropped);
+extern int	zou_wal_close(void);
+
+#define ZOU_ERR_LEASE_HELD (-5)
+
+/* One chunk per append, small enough to stay under the frame body cap. */
+#define ZOU_WAL_CHUNK (1024 * 1024)
+
+typedef struct ZouWalShmemStruct
+{
+	pg_atomic_uint64 durable_lsn;
+	ConditionVariable durable_cv;
+} ZouWalShmemStruct;
+
+static ZouWalShmemStruct *ZouWalShmem;
+
+bool
+ZouWalActive(void)
+{
+	return getenv("ZOU_TARGET") != NULL;
+}
+
+Size
+ZouWalShmemSize(void)
+{
+	return sizeof(ZouWalShmemStruct);
+}
+
+void
+ZouWalShmemInit(void)
+{
+	bool		found;
+
+	ZouWalShmem = (ZouWalShmemStruct *)
+		ShmemInitStruct("zou wal", sizeof(ZouWalShmemStruct), &found);
+	if (!found)
+	{
+		pg_atomic_init_u64(&ZouWalShmem->durable_lsn, 0);
+		ConditionVariableInit(&ZouWalShmem->durable_cv);
+	}
+}
+
+void
+ZouWalRegister(void)
+{
+	BackgroundWorker bgw;
+
+	if (!ZouWalActive())
+		return;
+
+	memset(&bgw, 0, sizeof(bgw));
+	bgw.bgw_flags = BGWORKER_SHMEM_ACCESS;
+	bgw.bgw_start_time = BgWorkerStart_RecoveryFinished;
+	bgw.bgw_restart_time = 1;
+	snprintf(bgw.bgw_library_name, sizeof(bgw.bgw_library_name), "postgres");
+	snprintf(bgw.bgw_function_name, sizeof(bgw.bgw_function_name),
+			 "ZouWalPusherMain");
+	snprintf(bgw.bgw_name, BGW_MAXLEN, "zou wal pusher");
+	snprintf(bgw.bgw_type, BGW_MAXLEN, "zou wal pusher");
+	RegisterBackgroundWorker(&bgw);
+}
+
+/*
+ * Read [start, start + count) out of pg_wal into buf. The range is
+ * already flushed, so the segment files exist and are stable.
+ */
+static void
+zou_wal_read_range(XLogRecPtr start, size_t count, TimeLineID tli, char *buf)
+{
+	while (count > 0)
+	{
+		XLogSegNo	segno;
+		char		fname[MAXFNAMELEN];
+		char		path[MAXPGPATH];
+		uint32		off = XLogSegmentOffset(start, wal_segment_size);
+		size_t		n = Min(count, (size_t) wal_segment_size - off);
+		int			fd;
+		ssize_t		got;
+
+		XLByteToSeg(start, segno, wal_segment_size);
+		XLogFileName(fname, tli, segno, wal_segment_size);
+		snprintf(path, MAXPGPATH, XLOGDIR "/%s", fname);
+
+		fd = OpenTransientFile(path, O_RDONLY | PG_BINARY);
+		if (fd < 0)
+			ereport(ERROR,
+					(errcode_for_file_access(),
+					 errmsg("zou wal pusher could not open \"%s\": %m", path)));
+		got = pg_pread(fd, buf, n, (off_t) off);
+		if (got != (ssize_t) n)
+			ereport(ERROR,
+					(errcode_for_file_access(),
+					 errmsg("zou wal pusher short read in \"%s\": %zd of %zu at %u",
+							path, got, n, off)));
+		CloseTransientFile(fd);
+
+		start += n;
+		buf += n;
+		count -= n;
+	}
+}
+
+static void
+zou_wal_publish(XLogRecPtr durable)
+{
+	pg_atomic_write_u64(&ZouWalShmem->durable_lsn, (uint64) durable);
+	ConditionVariableBroadcast(&ZouWalShmem->durable_cv);
+}
+
+static void
+zou_wal_on_exit(int code, Datum arg)
+{
+	(void) zou_wal_close();
+}
+
+void
+ZouWalPusherMain(Datum main_arg)
+{
+	const char *target = getenv("ZOU_TARGET");
+	TimeLineID	tli;
+	XLogRecPtr	pushed;
+	XLogRecPtr	folded;
+	TimeLineID	foldtli;
+	int			fold_backoff = 0;
+	uint64		resume = 0;
+	char	   *buf;
+
+	/*
+	 * A smart shutdown must not kill the pusher mid stream. Catch SIGTERM
+	 * and drain everything the cluster has flushed before exiting.
+	 */
+	pqsignal(SIGTERM, SignalHandlerForShutdownRequest);
+	BackgroundWorkerUnblockSignals();
+
+	if (target == NULL)
+		ereport(FATAL,
+				(errmsg("zou wal pusher started without ZOU_TARGET")));
+
+	/*
+	 * Mirroring starts at the current flush pointer on a fresh store.
+	 * Bytes before the first start are covered by the bootstrap
+	 * checkpoint capture.
+	 */
+	pushed = GetFlushRecPtr(&tli);
+
+	/*
+	 * Become the writer. After a crash the previous incarnation's lease
+	 * has to expire first, so retry until the store lets us in.
+	 */
+	for (;;)
+	{
+		int			rc = zou_wal_open(target, (uint64) pushed, &resume);
+
+		if (rc == 0)
+			break;
+		if (rc != ZOU_ERR_LEASE_HELD)
+			ereport(FATAL,
+					(errmsg("zou wal pusher failed to open store \"%s\": %d",
+							target, rc)));
+		ereport(LOG,
+				(errmsg("zou wal pusher waiting for the previous writer lease to expire")));
+		(void) WaitLatch(MyLatch, WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+						 1000, PG_WAIT_EXTENSION);
+		ResetLatch(MyLatch);
+	}
+	on_proc_exit(zou_wal_on_exit, (Datum) 0);
+
+	/*
+	 * On a store that already holds WAL, restart right after its last
+	 * record. The previous incarnation can have exited before pushing
+	 * everything, the shutdown checkpoint record at least, so the resume
+	 * point usually trails the local flush pointer and those bytes are
+	 * re-read from pg_wal now.
+	 */
+	if (resume != 0)
+	{
+		if ((XLogRecPtr) resume > pushed)
+			ereport(FATAL,
+					(errmsg("zou store holds WAL through %X/%X but local flush is only %X/%X",
+							LSN_FORMAT_ARGS((XLogRecPtr) resume),
+							LSN_FORMAT_ARGS(pushed))));
+		if ((XLogRecPtr) resume < pushed)
+			ereport(LOG,
+					(errmsg("zou wal pusher re-pushing %X/%X to %X/%X missed by the previous session",
+							LSN_FORMAT_ARGS((XLogRecPtr) resume),
+							LSN_FORMAT_ARGS(pushed))));
+		pushed = (XLogRecPtr) resume;
+	}
+
+	ereport(LOG,
+			(errmsg("zou wal pusher mirroring from %X/%X into \"%s\"",
+					LSN_FORMAT_ARGS(pushed), target)));
+	zou_wal_publish(pushed);
+
+	/*
+	 * Folding starts from the checkpoint already completed at startup, the
+	 * store either has its delta or the history back to genesis, either
+	 * way there is nothing new to fold yet.
+	 */
+	GetOldestRestartPoint(&folded, &foldtli);
+
+	buf = palloc(ZOU_WAL_CHUNK);
+	for (;;)
+	{
+		XLogRecPtr	flush = GetFlushRecPtr(&tli);
+
+		if (flush > pushed)
+		{
+			size_t		n = Min((size_t) (flush - pushed), (size_t) ZOU_WAL_CHUNK);
+			uint64		durable;
+			int			rc;
+
+			zou_wal_read_range(pushed, n, tli, buf);
+			rc = zou_wal_append((const uint8 *) buf, n, (uint64) pushed, &durable);
+			if (rc != 0)
+				ereport(FATAL,
+						(errmsg("zou wal pusher append failed: %d", rc)));
+			pushed += n;
+			zou_wal_publish(pushed);
+		}
+		else if (ShutdownRequestPending)
+		{
+			/*
+			 * The flush pointer is drained, but WAL can still sit in
+			 * the buffers, hint bit FPIs from read only queries at
+			 * least. The shutdown checkpoint that runs after this
+			 * worker exits will flush pages whose LSNs point at those
+			 * records, and the write gate would wait for them forever.
+			 * Force the rest out and keep pushing until insert, flush,
+			 * and pushed all agree.
+			 */
+			XLogRecPtr	insert = GetXLogInsertRecPtr();
+
+			if (insert > pushed)
+			{
+				XLogFlush(insert);
+				continue;
+			}
+
+			/*
+			 * Fully drained and asked to stop. proc_exit runs
+			 * zou_wal_on_exit, which seals the tail and releases the
+			 * lease cleanly.
+			 */
+			ereport(LOG,
+					(errmsg("zou wal pusher drained through %X/%X, shutting down",
+							LSN_FORMAT_ARGS(pushed))));
+			proc_exit(0);
+		}
+		else
+		{
+			XLogRecPtr	redo;
+
+			/*
+			 * Fully caught up is the only safe moment to fold: everything
+			 * the completed checkpoint references, its own record
+			 * included, is durable in the store. GetOldestRestartPoint
+			 * reads the control file, so redo only moves once a
+			 * checkpoint has fully completed and flushed its pages.
+			 */
+			GetOldestRestartPoint(&redo, &foldtli);
+			if (redo > folded && pushed >= redo && fold_backoff == 0)
+			{
+				uint32		dropped = 0;
+				int			rc = zou_wal_fold((uint64) redo, &dropped);
+
+				if (rc == 0)
+				{
+					folded = redo;
+					ereport(LOG,
+							(errmsg("zou wal pusher folded a delta checkpoint at %X/%X, dropped %u sealed segments",
+									LSN_FORMAT_ARGS(redo), dropped)));
+				}
+				else
+				{
+					/* about five seconds of idle passes before a retry */
+					fold_backoff = 1000;
+					ereport(WARNING,
+							(errmsg("zou wal fold at %X/%X failed: %d, will retry",
+									LSN_FORMAT_ARGS(redo), rc)));
+				}
+			}
+			else if (fold_backoff > 0)
+				fold_backoff--;
+
+			(void) WaitLatch(MyLatch, WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+							 5, PG_WAIT_EXTENSION);
+			ResetLatch(MyLatch);
+		}
+	}
+}
+
+/*
+ * Block until the object store holds WAL through lsn. Called by
+ * committing backends after their local flush. A no op for standalone
+ * processes (initdb, bootstrap) and clusters without ZOU_TARGET.
+ */
+void
+ZouWalWaitForLSN(XLogRecPtr lsn)
+{
+	if (!IsUnderPostmaster || ZouWalShmem == NULL || !ZouWalActive())
+		return;
+
+	/*
+	 * Recovery cannot wait: the pusher only starts once recovery
+	 * finishes, so waiting here would deadlock the startup process
+	 * against a worker that cannot run yet. A node attached with
+	 * zou-restore only replays WAL the store already holds, which makes
+	 * the skip safe. An in place crash restart replaying local WAL the
+	 * store has not seen yet can push pages early during recovery; the
+	 * fix is starting the pusher at consistent state, noted in the
+	 * milestone issue.
+	 */
+	if (RecoveryInProgress())
+		return;
+
+	if ((XLogRecPtr) pg_atomic_read_u64(&ZouWalShmem->durable_lsn) >= lsn)
+		return;
+
+	ConditionVariablePrepareToSleep(&ZouWalShmem->durable_cv);
+	while ((XLogRecPtr) pg_atomic_read_u64(&ZouWalShmem->durable_lsn) < lsn)
+		ConditionVariableSleep(&ZouWalShmem->durable_cv, PG_WAIT_EXTENSION);
+	ConditionVariableCancelSleep();
+}
