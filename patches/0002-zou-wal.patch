diff --git a/src/include/access/zou_wal.h b/src/include/access/zou_wal.h
new file mode 100644
index 0000000..ce7e550
--- /dev/null
+++ b/src/include/access/zou_wal.h
@@ -0,0 +1,40 @@
+/*-------------------------------------------------------------------------
+ *
+ * zou_wal.h
+ *	  mirrors flushed WAL into zou-store and gates COMMIT on the
+ *	  durable object storage flush.
+ *
+ *	  Part of the zou patch series, not upstream PostgreSQL.
+ *
+ * src/include/access/zou_wal.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef ZOU_WAL_H
+#define ZOU_WAL_H
+
+#include "access/xlogdefs.h"
+
+/* Is WAL mirroring configured for this cluster? */
+extern bool ZouWalActive(void);
+
+/* Shared memory for the durable LSN handoff. */
+extern Size ZouWalShmemSize(void);
+extern void ZouWalShmemInit(void);
+
+/* Postmaster: register the pusher background worker. */
+extern void ZouWalRegister(void);
+
+/* Pusher worker entry point. */
+extern void ZouWalPusherMain(Datum main_arg);
+
+/* Page service worker entry point, see ZOU_PAGESERVE. */
+extern void ZouPageServiceMain(Datum main_arg);
+
+/* Backends: block until the store holds WAL through lsn. */
+extern void ZouWalWaitForLSN(XLogRecPtr lsn);
+
+/* The published durable LSN, InvalidXLogRecPtr before the first publish. */
+extern XLogRecPtr ZouWalDurableLSN(void);
+
+#endif							/* ZOU_WAL_H */
