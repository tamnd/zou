diff --git a/src/backend/access/transam/zou_wal.c b/src/backend/access/transam/zou_wal.c
new file mode 100644
index 0000000..ad24f0b
--- /dev/null
+++ b/src/backend/access/transam/zou_wal.c
@@ -0,0 +1,655 @@
+/*-------------------------------------------------------------------------
+ *
+ * zou_wal.c
+ *	  mirrors flushed WAL into zou-store and gates COMMIT on the
+ *	  durable object storage flush.
+ *
+ *	  zou-store has a single writer lease per tenant, but XLogWrite runs
+ *	  in whichever process holds WALWriteLock, so the push cannot happen
+ *	  at the flush site. Instead one background worker, the zou wal
+ *	  pusher, owns the lease and tails pg_wal: it reads every byte the
+ *	  cluster has flushed locally, stages it into the zou group commit
+ *	  pipeline, and publishes the durable LSN into shared memory as the
+ *	  store acknowledges batches. Committing backends wake the pusher
+ *	  after their local flush and wait on that LSN, the same shape as a
+ *	  synchronous replication ack.
+ *
+ *	  Part of the zou patch series, not upstream PostgreSQL.
+ *
+ * src/backend/access/transam/zou_wal.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <fcntl.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include "access/xlog.h"
+#include "access/xlog_internal.h"
+#include "access/zou_wal.h"
+#include "miscadmin.h"
+#include "pgstat.h"
+#include "port/atomics.h"
+#include "postmaster/bgworker.h"
+#include "postmaster/interrupt.h"
+#include "storage/condition_variable.h"
+#include "storage/fd.h"
+#include "storage/ipc.h"
+#include "storage/latch.h"
+#include "storage/shmem.h"
+#include "utils/wait_event.h"
+
+/* C ABI of the zou-pg crate (crates/zou-pg). */
+extern int	zou_wal_open(const char *target, uint64 flush_lsn,
+						 uint64 *out_resume);
+extern int	zou_wal_append(const uint8 *data, size_t len, uint64 pg_lsn,
+						   uint64 *out_durable);
+extern int	zou_wal_durable(uint64 *out_pg_lsn);
+extern int	zou_wal_fold_start(uint64 redo);
+extern int	zou_wal_fold_poll(uint64 *out_redo, uint32 *out_dropped);
+extern int	zou_wal_close(void);
+extern int	zou_pagesvc_start(const char *target, int data_checksums);
+extern int	zou_pagesvc_stop(void);
+
+#define ZOU_ERR_LEASE_HELD (-5)
+#define ZOU_ERR_THROTTLED (-7)
+
+/* zou_wal_fold_poll answers, mirroring the ZOU_FOLD_* consts in the crate. */
+#define ZOU_FOLD_IDLE 0
+#define ZOU_FOLD_RUNNING 1
+#define ZOU_FOLD_DONE_DELTA 2
+#define ZOU_FOLD_DONE_FULL 3
+
+/* One chunk per append, small enough to stay under the frame body cap. */
+#define ZOU_WAL_CHUNK (1024 * 1024)
+
+typedef struct ZouWalShmemStruct
+{
+	pg_atomic_uint64 durable_lsn;
+	ConditionVariable durable_cv;
+
+	/*
+	 * The pusher's process latch, so committing backends can wake it
+	 * the moment their WAL is flushed and ready to push. It points at
+	 * the pusher's PGPROC latch, which lives in shared memory for the
+	 * postmaster's whole life, and a spurious set after a pusher
+	 * restart is harmless, latch waits are loop guarded.
+	 */
+	Latch	   *pusher_latch;
+} ZouWalShmemStruct;
+
+static ZouWalShmemStruct *ZouWalShmem;
+
+bool
+ZouWalActive(void)
+{
+	return getenv("ZOU_TARGET") != NULL;
+}
+
+Size
+ZouWalShmemSize(void)
+{
+	return sizeof(ZouWalShmemStruct);
+}
+
+void
+ZouWalShmemInit(void)
+{
+	bool		found;
+
+	ZouWalShmem = (ZouWalShmemStruct *)
+		ShmemInitStruct("zou wal", sizeof(ZouWalShmemStruct), &found);
+	if (!found)
+	{
+		pg_atomic_init_u64(&ZouWalShmem->durable_lsn, 0);
+		ConditionVariableInit(&ZouWalShmem->durable_cv);
+		ZouWalShmem->pusher_latch = NULL;
+	}
+}
+
+void
+ZouWalRegister(void)
+{
+	BackgroundWorker bgw;
+
+	if (!ZouWalActive())
+		return;
+
+	memset(&bgw, 0, sizeof(bgw));
+	bgw.bgw_flags = BGWORKER_SHMEM_ACCESS;
+	bgw.bgw_start_time = BgWorkerStart_RecoveryFinished;
+	/* Come back immediately: every second here is commit stall. */
+	bgw.bgw_restart_time = 0;
+	snprintf(bgw.bgw_library_name, sizeof(bgw.bgw_library_name), "postgres");
+	snprintf(bgw.bgw_function_name, sizeof(bgw.bgw_function_name),
+			 "ZouWalPusherMain");
+	snprintf(bgw.bgw_name, BGW_MAXLEN, "zou wal pusher");
+	snprintf(bgw.bgw_type, BGW_MAXLEN, "zou wal pusher");
+	RegisterBackgroundWorker(&bgw);
+
+	/*
+	 * The page service has to be up before recovery starts: with
+	 * ZOU_PAGESERVE=1 eager page puts are elided, so the startup
+	 * process reads pages the local tiers miss over its socket. The
+	 * pusher above cannot host it, RecoveryFinished is too late, hence
+	 * a worker of its own starting with the postmaster.
+	 */
+	if (getenv("ZOU_PAGESERVE") == NULL)
+		return;
+
+	memset(&bgw, 0, sizeof(bgw));
+	bgw.bgw_flags = BGWORKER_SHMEM_ACCESS;
+	bgw.bgw_start_time = BgWorkerStart_PostmasterStart;
+	/* Reads block on the socket, come back immediately after a crash. */
+	bgw.bgw_restart_time = 0;
+	snprintf(bgw.bgw_library_name, sizeof(bgw.bgw_library_name), "postgres");
+	snprintf(bgw.bgw_function_name, sizeof(bgw.bgw_function_name),
+			 "ZouPageServiceMain");
+	snprintf(bgw.bgw_name, BGW_MAXLEN, "zou page service");
+	snprintf(bgw.bgw_type, BGW_MAXLEN, "zou page service");
+	RegisterBackgroundWorker(&bgw);
+}
+
+/*
+ * Read [start, start + count) out of pg_wal into buf. The range is
+ * already flushed, so the segment files exist and are stable.
+ */
+static void
+zou_wal_read_range(XLogRecPtr start, size_t count, TimeLineID tli, char *buf)
+{
+	while (count > 0)
+	{
+		XLogSegNo	segno;
+		char		fname[MAXFNAMELEN];
+		char		path[MAXPGPATH];
+		uint32		off = XLogSegmentOffset(start, wal_segment_size);
+		size_t		n = Min(count, (size_t) wal_segment_size - off);
+		int			fd;
+		ssize_t		got;
+
+		XLByteToSeg(start, segno, wal_segment_size);
+		XLogFileName(fname, tli, segno, wal_segment_size);
+		snprintf(path, MAXPGPATH, XLOGDIR "/%s", fname);
+
+		fd = OpenTransientFile(path, O_RDONLY | PG_BINARY);
+		if (fd < 0)
+			ereport(ERROR,
+					(errcode_for_file_access(),
+					 errmsg("zou wal pusher could not open \"%s\": %m", path)));
+		got = pg_pread(fd, buf, n, (off_t) off);
+		if (got != (ssize_t) n)
+			ereport(ERROR,
+					(errcode_for_file_access(),
+					 errmsg("zou wal pusher short read in \"%s\": %zd of %zu at %u",
+							path, got, n, off)));
+		CloseTransientFile(fd);
+
+		start += n;
+		buf += n;
+		count -= n;
+	}
+}
+
+static void
+zou_wal_publish(XLogRecPtr durable)
+{
+	pg_atomic_write_u64(&ZouWalShmem->durable_lsn, (uint64) durable);
+	ConditionVariableBroadcast(&ZouWalShmem->durable_cv);
+}
+
+static void
+zou_wal_on_exit(int code, Datum arg)
+{
+	(void) zou_wal_close();
+}
+
+/*
+ * How long a starting pusher keeps waiting for a writer lease somebody
+ * else holds. Four TTLs by default, long enough that a predecessor
+ * winding down or a clock skewed by a second or two is never mistaken
+ * for a successor, short enough that a thawed machine stops before a
+ * client gives up on it. ZOU_LEASE_WAIT_SECS tunes it.
+ */
+static int
+zou_lease_wait_secs(void)
+{
+	const char *setting = getenv("ZOU_LEASE_WAIT_SECS");
+	int			secs;
+
+	if (setting == NULL)
+		return 60;
+	secs = atoi(setting);
+	return secs > 0 ? secs : 60;
+}
+
+void
+ZouWalPusherMain(Datum main_arg)
+{
+	const char *target = getenv("ZOU_TARGET");
+	TimeLineID	tli;
+	XLogRecPtr	pushed;
+	XLogRecPtr	published;
+	XLogRecPtr	folded;
+	TimeLineID	foldtli;
+	bool		fold_running = false;
+	bool		throttled = false;
+	int			fold_backoff = 0;
+	int			waited;
+	uint64		resume = 0;
+	char	   *buf;
+
+	/*
+	 * A smart shutdown must not kill the pusher mid stream. Catch SIGTERM
+	 * and drain everything the cluster has flushed before exiting.
+	 */
+	pqsignal(SIGTERM, SignalHandlerForShutdownRequest);
+	BackgroundWorkerUnblockSignals();
+
+	if (target == NULL)
+		ereport(FATAL,
+				(errmsg("zou wal pusher started without ZOU_TARGET")));
+
+	/*
+	 * Mirroring starts at the current flush pointer on a fresh store.
+	 * Bytes before the first start are covered by the bootstrap
+	 * checkpoint capture.
+	 */
+	pushed = GetFlushRecPtr(&tli);
+
+	/*
+	 * Become the writer. After a crash the previous incarnation's lease
+	 * has to expire first, so retry until the store lets us in.
+	 *
+	 * The retry is bounded, because a lease that never expires is not a
+	 * predecessor winding down, it is a successor renewing. That is what
+	 * a thaw looks like from in here: the machine was frozen past the
+	 * TTL, something else took the store, and this cluster's local WAL
+	 * is a branch nobody will ever read. Waiting on would leave a
+	 * postmaster that accepts connections and hangs every commit in the
+	 * write gate forever, since a backend past its flush has interrupts
+	 * held and cannot even be cancelled.
+	 */
+	for (waited = 0;; waited++)
+	{
+		int			rc = zou_wal_open(target, (uint64) pushed, &resume);
+
+		if (rc == 0)
+			break;
+		if (rc != ZOU_ERR_LEASE_HELD)
+			ereport(FATAL,
+					(errmsg("zou wal pusher failed to open store \"%s\": %d",
+							target, rc)));
+		if (waited >= zou_lease_wait_secs())
+		{
+			/*
+			 * Immediate and not a fast shutdown: a shutdown checkpoint
+			 * would flush WAL into the same write gate and hang there,
+			 * and this cluster has nothing worth writing anywhere. It
+			 * owns no lease, so nothing it holds locally is authoritative
+			 * and none of the commits blocked in the gate was ever
+			 * acked. The exit is what a platform health check sees, and
+			 * how traffic gets to the cluster that does own the store.
+			 */
+			ereport(WARNING,
+					(errmsg("zou wal pusher: the writer lease has been held elsewhere for %d seconds, this cluster has been replaced and is stopping",
+							waited)));
+			kill(PostmasterPid, SIGQUIT);
+			proc_exit(1);
+		}
+		ereport(LOG,
+				(errmsg("zou wal pusher waiting for the previous writer lease to expire")));
+		(void) WaitLatch(MyLatch, WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+						 1000, PG_WAIT_EXTENSION);
+		ResetLatch(MyLatch);
+	}
+	on_proc_exit(zou_wal_on_exit, (Datum) 0);
+
+	/*
+	 * On a store that already holds WAL, restart right after its last
+	 * record. The previous incarnation can have exited before pushing
+	 * everything, the shutdown checkpoint record at least, so the resume
+	 * point usually trails the local flush pointer and those bytes are
+	 * re-read from pg_wal now.
+	 */
+	if (resume != 0)
+	{
+		if ((XLogRecPtr) resume > pushed)
+			ereport(FATAL,
+					(errmsg("zou store holds WAL through %X/%X but local flush is only %X/%X",
+							LSN_FORMAT_ARGS((XLogRecPtr) resume),
+							LSN_FORMAT_ARGS(pushed))));
+		if ((XLogRecPtr) resume < pushed)
+			ereport(LOG,
+					(errmsg("zou wal pusher re-pushing %X/%X to %X/%X missed by the previous session",
+							LSN_FORMAT_ARGS((XLogRecPtr) resume),
+							LSN_FORMAT_ARGS(pushed))));
+		pushed = (XLogRecPtr) resume;
+	}
+
+	ereport(LOG,
+			(errmsg("zou wal pusher mirroring from %X/%X into \"%s\"",
+					LSN_FORMAT_ARGS(pushed), target)));
+	zou_wal_publish(pushed);
+	published = pushed;
+
+	/* Let committing backends wake us the moment they have flushed. */
+	ZouWalShmem->pusher_latch = MyLatch;
+
+	/*
+	 * Folding starts from the checkpoint already completed at startup, the
+	 * store either has its delta or the history back to genesis, either
+	 * way there is nothing new to fold yet.
+	 */
+	GetOldestRestartPoint(&folded, &foldtli);
+
+	buf = palloc(ZOU_WAL_CHUNK);
+	for (;;)
+	{
+		XLogRecPtr	flush = GetFlushRecPtr(&tli);
+
+		/*
+		 * The whole fold lifecycle, capture, publish, and shared log
+		 * consolidation, runs on a thread inside the shim, so this
+		 * loop never spends a store call on a fold's behalf and commit
+		 * acks never wait one out. The poll is a mutex peek that
+		 * harvests the verdict once the thread is done.
+		 */
+		if (fold_running)
+		{
+			uint64		fredo = 0;
+			uint32		dropped = 0;
+			int			rc = zou_wal_fold_poll(&fredo, &dropped);
+
+			if (rc == ZOU_FOLD_DONE_DELTA || rc == ZOU_FOLD_DONE_FULL)
+			{
+				fold_running = false;
+				folded = (XLogRecPtr) fredo;
+				ereport(LOG,
+						(errmsg("zou wal pusher folded a %s checkpoint at %X/%X, dropped %u sealed segments",
+								rc == ZOU_FOLD_DONE_FULL ? "full" : "delta",
+								LSN_FORMAT_ARGS(folded), dropped)));
+			}
+			else if (rc != ZOU_FOLD_RUNNING)
+			{
+				/*
+				 * A thousand iterations before the retry, five seconds
+				 * when idle, less while pushing. The fold is idempotent
+				 * per redo, the retry picks up where this one failed.
+				 */
+				fold_running = false;
+				fold_backoff = 1000;
+				ereport(WARNING,
+						(errmsg("zou wal fold at %X/%X failed: %d, will retry",
+								LSN_FORMAT_ARGS((XLogRecPtr) fredo), rc)));
+			}
+		}
+		else if (!ShutdownRequestPending)
+		{
+			XLogRecPtr	redo;
+
+			/*
+			 * A fold at redo may start once pushed covers it: everything
+			 * the completed checkpoint references, its own record
+			 * included, is then durable in the store, and the pusher
+			 * keeps pushing while the capture runs on its thread.
+			 * GetOldestRestartPoint reads the control file, so redo only
+			 * moves once a checkpoint has fully completed and flushed
+			 * its pages. Nothing new starts once shutdown is requested,
+			 * a capture the exit would abandon is wasted work.
+			 */
+			GetOldestRestartPoint(&redo, &foldtli);
+			if (redo > folded && pushed >= redo && fold_backoff == 0)
+			{
+				int			rc = zou_wal_fold_start((uint64) redo);
+
+				if (rc == 0)
+					fold_running = true;
+				else
+				{
+					fold_backoff = 1000;
+					ereport(WARNING,
+							(errmsg("zou wal fold start at %X/%X failed: %d, will retry",
+									LSN_FORMAT_ARGS(redo), rc)));
+				}
+			}
+			else if (fold_backoff > 0)
+				fold_backoff--;
+		}
+
+		if (flush > pushed)
+		{
+			size_t		n = Min((size_t) (flush - pushed), (size_t) ZOU_WAL_CHUNK);
+			uint64		durable;
+			int			rc;
+
+			/*
+			 * The append stages the chunk and returns, the store lands
+			 * it behind our back and the poll below picks the ack up.
+			 * A full pipeline blocks inside the shim, which is the
+			 * backpressure that bounds staged WAL in memory.
+			 */
+			zou_wal_read_range(pushed, n, tli, buf);
+			rc = zou_wal_append((const uint8 *) buf, n, (uint64) pushed, &durable);
+			if (rc == ZOU_ERR_THROTTLED)
+			{
+				/*
+				 * The lag bounds refused admission, consolidation is
+				 * too far behind. Nap and retry the same chunk: staged
+				 * WAL stops growing, the commit gate stalls honestly,
+				 * and the fold thread's next backlog report lifts the
+				 * throttle. Log once per streak, not per retry.
+				 */
+				if (!throttled)
+					ereport(LOG,
+							(errmsg("zou wal pusher throttled, consolidation is behind")));
+				throttled = true;
+				(void) WaitLatch(MyLatch,
+								 WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+								 100, PG_WAIT_EXTENSION);
+				ResetLatch(MyLatch);
+			}
+			else if (rc != 0)
+				ereport(FATAL,
+						(errmsg("zou wal pusher append failed: %d", rc)));
+			else
+			{
+				if (throttled)
+					ereport(LOG,
+							(errmsg("zou wal pusher throttle lifted")));
+				throttled = false;
+				pushed += n;
+			}
+		}
+		else if (ShutdownRequestPending && published == pushed)
+		{
+			/*
+			 * The flush pointer is drained, but WAL can still sit in
+			 * the buffers, hint bit FPIs from read only queries at
+			 * least. The shutdown checkpoint that runs after this
+			 * worker exits will flush pages whose LSNs point at those
+			 * records, and the write gate would wait for them forever.
+			 * Force the rest out and keep pushing until insert, flush,
+			 * pushed, and the durable watermark all agree.
+			 */
+			XLogRecPtr	insert = GetXLogInsertRecPtr();
+
+			if (insert > pushed)
+			{
+				XLogFlush(insert);
+				continue;
+			}
+
+			/*
+			 * Fully drained, fully durable, and asked to stop.
+			 * proc_exit runs zou_wal_on_exit, which seals the tail and
+			 * releases the lease cleanly. A fold still in flight is
+			 * abandoned, the shim logs it, its publish either landed
+			 * whole or left no manifest edit, leftover capture objects
+			 * are gc food, and the next start refolds the same redo.
+			 */
+			ereport(LOG,
+					(errmsg("zou wal pusher drained through %X/%X, shutting down",
+							LSN_FORMAT_ARGS(pushed))));
+			proc_exit(0);
+		}
+		else
+		{
+			/*
+			 * Nothing new to read. While staged chunks are in flight
+			 * the nap stays short so the poll below publishes their
+			 * acks promptly, idle it stretches, and backends set our
+			 * latch when they commit so the stretch costs them nothing.
+			 */
+			(void) WaitLatch(MyLatch, WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+							 published < pushed ? 1 : 5, PG_WAIT_EXTENSION);
+			ResetLatch(MyLatch);
+		}
+
+		/*
+		 * Publish whatever the pipeline made durable since the last
+		 * look. The commit gate sleeps on this value, so it has to move
+		 * every iteration, not only when new WAL shows up. An append
+		 * that failed after staging surfaces here, and the restart
+		 * re-pushes from the store's stream end.
+		 */
+		{
+			uint64		durable = 0;
+			int			rc = zou_wal_durable(&durable);
+
+			if (rc != 0)
+				ereport(FATAL,
+						(errmsg("zou wal pusher durability poll failed: %d", rc)));
+			if ((XLogRecPtr) durable > published)
+			{
+				zou_wal_publish((XLogRecPtr) durable);
+				published = (XLogRecPtr) durable;
+			}
+		}
+	}
+}
+
+/*
+ * Block until the object store holds WAL through lsn. Called by
+ * committing backends after their local flush. A no op for standalone
+ * processes (initdb, bootstrap) and clusters without ZOU_TARGET.
+ */
+void
+ZouWalWaitForLSN(XLogRecPtr lsn)
+{
+	if (!IsUnderPostmaster || ZouWalShmem == NULL || !ZouWalActive())
+		return;
+
+	/*
+	 * Recovery cannot wait: the pusher only starts once recovery
+	 * finishes, so waiting here would deadlock the startup process
+	 * against a worker that cannot run yet. A node attached with
+	 * zou-restore only replays WAL the store already holds, which makes
+	 * the skip safe. An in place crash restart replaying local WAL the
+	 * store has not seen yet can push pages early during recovery; the
+	 * fix is starting the pusher at consistent state, noted in the
+	 * milestone issue.
+	 */
+	if (RecoveryInProgress())
+		return;
+
+	if ((XLogRecPtr) pg_atomic_read_u64(&ZouWalShmem->durable_lsn) >= lsn)
+		return;
+
+	/*
+	 * Poke the pusher: our WAL is flushed and ready for it, and it may
+	 * be sitting in its idle nap. The unlocked read is fine, the
+	 * pointer is set once per pusher start and targets shared memory
+	 * that never moves.
+	 */
+	if (ZouWalShmem->pusher_latch != NULL)
+		SetLatch(ZouWalShmem->pusher_latch);
+
+	ConditionVariablePrepareToSleep(&ZouWalShmem->durable_cv);
+	while ((XLogRecPtr) pg_atomic_read_u64(&ZouWalShmem->durable_lsn) < lsn)
+		ConditionVariableSleep(&ZouWalShmem->durable_cv, PG_WAIT_EXTENSION);
+	ConditionVariableCancelSleep();
+}
+
+/*
+ * The durable LSN the pusher last published, InvalidXLogRecPtr when no
+ * pusher has published one yet. The chain reader in the storage manager
+ * uses it to skip its freshness barrier: the page write gate above reads
+ * the same value before a page object may mutate, so any page change is
+ * preceded by an advance of this LSN, and a reader that sees it
+ * unchanged since its last stream scan cannot be missing WAL.
+ */
+XLogRecPtr
+ZouWalDurableLSN(void)
+{
+	if (!IsUnderPostmaster || ZouWalShmem == NULL || !ZouWalActive())
+		return InvalidXLogRecPtr;
+	return (XLogRecPtr) pg_atomic_read_u64(&ZouWalShmem->durable_lsn);
+}
+
+static void
+zou_pagesvc_on_exit(int code, Datum arg)
+{
+	(void) zou_pagesvc_stop();
+}
+
+/*
+ * The zou page service worker: hosts the GetPage server the storage
+ * manager reads from when eager page puts are elided. All the work,
+ * ingest polling, reconstruction, and the socket, runs on threads
+ * inside the shim; this process exists so those threads start with the
+ * postmaster, survive backend churn, and stop cleanly with the
+ * cluster. It ingests by polling the store rather than by the pusher's
+ * tee, which is what lets it serve the startup process while the
+ * pusher is not running yet.
+ */
+void
+ZouPageServiceMain(Datum main_arg)
+{
+	const char *target = getenv("ZOU_TARGET");
+	int			rc;
+
+	pqsignal(SIGTERM, SignalHandlerForShutdownRequest);
+	BackgroundWorkerUnblockSignals();
+
+	/*
+	 * The restart delay is zero because readers block on the socket, so
+	 * a failure that repeats, a bad socket path say, would respawn this
+	 * worker as fast as the postmaster can fork. Pace the exit instead.
+	 */
+	if (target == NULL)
+	{
+		pg_usleep(1000 * 1000L);
+		ereport(FATAL,
+				(errmsg("zou page service started without ZOU_TARGET")));
+	}
+
+	rc = zou_pagesvc_start(target, DataChecksumsEnabled() ? 1 : 0);
+	if (rc != 0)
+	{
+		pg_usleep(1000 * 1000L);
+		ereport(FATAL,
+				(errmsg("zou page service failed to start: %d", rc)));
+	}
+	on_proc_exit(zou_pagesvc_on_exit, (Datum) 0);
+
+	ereport(LOG,
+			(errmsg("zou page service serving \"%s\"", target)));
+
+	while (!ShutdownRequestPending)
+	{
+		(void) WaitLatch(MyLatch, WL_LATCH_SET | WL_TIMEOUT | WL_EXIT_ON_PM_DEATH,
+						 1000, PG_WAIT_EXTENSION);
+		ResetLatch(MyLatch);
+	}
+
+	/*
+	 * proc_exit runs zou_pagesvc_on_exit, which flushes the ingest tail
+	 * into a layer and advances the shard manifest, so the next start
+	 * anchors there instead of re-ingesting the whole retained stream.
+	 */
+	ereport(LOG,
+			(errmsg("zou page service shutting down")));
+	proc_exit(0);
+}
